{
  "name": "unifiedcollector-whatsapp-bridge",
  "version": "1.0.0",
  "description": "Native WhatsApp bridge for unifiedcollector. Connects to WhatsApp via Baileys and publishes normalized message/chat/contact events to the RabbitMQ 'whatsapp.events' topic exchange for the Python whatsapp collector to consume.",
  "main": "build/index.js",
  "scripts": {
    "start": "node build/index.js",
    "dev": "ts-node src/index.ts",
    "build": "npx tsc"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "amqplib": "^2.0.1",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "axios": "^1.8.2",
    "body-parser": "1.20.6",
    "brace-expansion": "1.1.13",
    "follow-redirects": "^1.15.9",
    "path-to-regexp": "0.1.13",
    "protobufjs": "7.6.5",
    "sharp": "0.35.3"
  }
}
