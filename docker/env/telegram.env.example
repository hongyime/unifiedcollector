# telegram.env.example - per-service scoped env template.
# Scope: collector_telegram, onboard_bot.
# Rotation: rotating a Telegram API_ID/HASH or session touches this file only.
# NOTE: send-only alerting tokens live in telegram_notify.env; onboarding bot
# tokens live in telegram_onboard.env - each is independently rotatable.
# Copy to telegram.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Global Telegram API credentials ----------------------------------------
TELEGRAM_API_ID=  # REQUIRED - set your own secret
TELEGRAM_API_HASH=  # REQUIRED - set your own secret

# -- Primary collector bot token (distinct from notify + onboarding bots) ---
TELEGRAM_BOT_TOKEN=  # REQUIRED - set your own secret
TELEGRAM_BOT_TOKENS=  # REQUIRED - set your own secret (semicolon-separated Bot:ID:Token triples)

# -- Hub group (excluded from ingestion loop) -------------------------------
TELEGRAM_HUB_GROUP=
TELEGRAM_HUB_GROUP_ID=

# -- Story scan cadence -----------------------------------------------------
TELEGRAM_STORY_SCAN_INTERVAL=
TELEGRAM_STORY_SCAN_ENABLED=

# -- Backfill controls ------------------------------------------------------
TELEGRAM_BACKFILL_ENABLED=
TELEGRAM_BACKFILL_MSG_PER_SEC=
TELEGRAM_BACKFILL_BATCH_SIZE=
TELEGRAM_MAX_MEDIA_SIZE_MB=

# -- MTProto Account 1 ------------------------------------------------------
TELEGRAM_ACCOUNT_1_NAME=
TELEGRAM_ACCOUNT_1_API_ID=  # REQUIRED - set your own secret
TELEGRAM_ACCOUNT_1_API_HASH=  # REQUIRED - set your own secret
TELEGRAM_ACCOUNT_1_PHONE=
TELEGRAM_ACCOUNT_1_SESSION=
TELEGRAM_ACCOUNT_1_PREFIX=

# -- MTProto Account 2 ------------------------------------------------------
TELEGRAM_ACCOUNT_2_NAME=
TELEGRAM_ACCOUNT_2_API_ID=  # REQUIRED - set your own secret
TELEGRAM_ACCOUNT_2_API_HASH=  # REQUIRED - set your own secret
TELEGRAM_ACCOUNT_2_PHONE=
TELEGRAM_ACCOUNT_2_SESSION=
TELEGRAM_ACCOUNT_2_PREFIX=

# -- MTProto Account 3 ------------------------------------------------------
TELEGRAM_ACCOUNT_3_NAME=
TELEGRAM_ACCOUNT_3_API_ID=  # REQUIRED - set your own secret
TELEGRAM_ACCOUNT_3_API_HASH=  # REQUIRED - set your own secret
TELEGRAM_ACCOUNT_3_PHONE=
TELEGRAM_ACCOUNT_3_SESSION=
TELEGRAM_ACCOUNT_3_PREFIX=

# -- MTProto Account 4 ------------------------------------------------------
TELEGRAM_ACCOUNT_4_NAME=
TELEGRAM_ACCOUNT_4_API_ID=  # REQUIRED - set your own secret
TELEGRAM_ACCOUNT_4_API_HASH=  # REQUIRED - set your own secret
TELEGRAM_ACCOUNT_4_PHONE=
TELEGRAM_ACCOUNT_4_SESSION=
TELEGRAM_ACCOUNT_4_PREFIX=

# -- Spider allowlist (comma-separated account names; empty = all) ----------
TELEGRAM_SPIDER_ACCOUNTS=

# -- User ID allowlist for privileged bot commands --------------------------
TELEGRAM_ALLOWED_USER_IDS=
