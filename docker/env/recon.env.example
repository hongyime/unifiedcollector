# recon.env.example - per-service scoped env template.
# Scope: collector_spiderfoot ONLY.
# Rotation: rotating GHUNT_CREDS or changing recon scope touches this file only.
# THIS FILE INTENTIONALLY OMITS every collector platform credential.
# The recon worker runs untrusted third-party OSINT (maigret against 3000+
# sites, GHunt against unofficial Google endpoints); it must not have access
# to Instagram passwords, Telegram API hashes, WhatsApp session secrets, etc.
# Compose mounts the shared read-only admission policy and private state ledger.
# The checked-in state starts halted at the five-target cohort; explicit canary
# activation is required before either recon claims or scheduler seeding proceed.

# -- Username fan-out engine (maigret | sfp_accounts) -----------------------
RECON_USERNAME_ENGINE=

# -- Worker pool ------------------------------------------------------------
RECON_SPIDERFOOT_WORKERS=
RECON_SPIDERFOOT_POLL_INTERVAL=
RECON_MAX_TARGETS_PER_RUN=10
RECON_RUN_DEADLINE_SECONDS=1800
RECON_RUN_COOLDOWN_SECONDS=3600
RECON_MAX_EGRESS_BYTES=1073741824
RECON_MIN_DISK_FREE_BYTES=2147483648
RECON_MAX_EVIDENCE_BYTES=10737418240
RECON_ADMISSION_POLICY_PATH=/app/config/task-37-admission-policy.json
RECON_ADMISSION_STATE_PATH=/var/lib/unifiedcollector/recon-admission/task-37-admission-state.json
RECON_ADMISSION_STATE_MODE=0660
RECON_ADMISSION_SHARED_GID=1000
RECON_EVIDENCE_ROOT=/var/lib/unifiedcollector/recon-evidence
RECON_UID=1000
RECON_GID=1000

# -- SpiderFoot CLI + modules -----------------------------------------------
SPIDERFOOT_CLI=
SPIDERFOOT_MODULES=sfp_dnsresolve,sfp_whois,sfp_names,sfp_dnsbrute,sfp_portscan_tcp
SPIDERFOOT_MAX_MODULES=10
SPIDERFOOT_MAX_THREADS=
SPIDERFOOT_TARGET_TIMEOUT_SECONDS=
SPIDERFOOT_STALE_TARGET_MINUTES=
RECON_HEALTH_MAX_AGE_SECONDS=360
SPIDERFOOT_STATE_ROOT=

# -- Maigret ----------------------------------------------------------------
MAIGRET_TOP_SITES=
MAIGRET_NUM_REQUESTS=
MAIGRET_HTTP_TIMEOUT_SECONDS=
MAIGRET_TARGET_TIMEOUT_SECONDS=

# -- Maigret FP blocklist refresh -------------------------------------------
RECON_MAIGRET_FP_CONTROLS=
RECON_MAIGRET_FP_INTERVAL_SECONDS=

# -- GHunt (email -> Google account; credential-gated) ----------------------
GHUNT_CREDS=

# -- Added by verify_env_split.py iteration --------------------------------
GHUNT_MAX_JITTER_SECONDS=
GHUNT_MIN_DELAY_SECONDS=
GHUNT_TARGET_TIMEOUT_SECONDS=
MAIGRET_CLI=
MAIGRET_REPORT_KEEPDIR=/var/lib/unifiedcollector/recon-evidence/maigret
RECON_EMAIL_ENGINE=
RECON_USERNAME_MODULES=
