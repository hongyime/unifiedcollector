# broker.env.example - per-service scoped env template.
# Scope: rabbitmq, redis, collector_whatsapp, postgres (POSTGRES_* only).
# Rotation: rotating the RabbitMQ or Redis service password touches this file
# only. Rotating those passwords also requires updating WHATSAPP_RABBITMQ_URL /
# WHATSAPP_REDIS_URL in whatsapp.env because they embed the credentials.
# Copy to broker.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=
RABBITMQ_PASSWORD=  # REQUIRED - set your own secret
RABBITMQ_VHOST=

# -- Redis ------------------------------------------------------------------
REDIS_PASSWORD=  # REQUIRED - set your own secret

# -- Added by verify_env_split.py iteration --------------------------------
RABBITMQ_URL=
