# dashboard.env.example - per-service scoped env template.
# Scope: dashboard.
# Rotation: rotating the dashboard admin password or JWT secret touches this file only.
# Copy to dashboard.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Admin credentials ------------------------------------------------------
DASHBOARD_ADMIN_USERNAME=
DASHBOARD_ADMIN_PASSWORD=  # REQUIRED - set your own secret
DASHBOARD_JWT_SECRET=  # REQUIRED - set your own secret

# -- Localhost-only auth bypass (leave 0 for any network exposure) ----------
DASHBOARD_AUTH_DISABLED=

# -- Browser extension version pin (drives dashboard health card) -----------
UC_EXTENSION_EXPECTED_VERSION=
