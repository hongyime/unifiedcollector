# tiktok.env.example - per-service scoped env template.
# Scope: collector_tiktok.
# Rotation: rotating a TikTok cookie or session id touches this file only.
# Copy to tiktok.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Cookie source ----------------------------------------------------------
# Leave TIKTOK_COOKIES_FILE empty to auto-discover credentials/tiktok/tiktok_<user>.txt.
TIKTOK_COOKIES_FILE=  # REQUIRED - set your own secret
TIKTOK_SESSION_ID=

# -- Pacing + retries -------------------------------------------------------
TIKTOK_MIN_SLEEP=
TIKTOK_MAX_SLEEP=
TIKTOK_RETRIES=
TIKTOK_TIMEOUT_SECONDS=

# -- Fallback pipeline toggles ----------------------------------------------
TIKTOK_BROWSER_FALLBACK_ENABLED=
TIKTOK_YTDLP_FALLBACK_ENABLED=
TIKTOK_GALLERY_DL_ENABLED=

# -- Request identity -------------------------------------------------------
TIKTOK_USER_AGENT=

# -- Spider concurrency -----------------------------------------------------
TIKTOK_SPIDER_CONCURRENCY=

# -- Added by verify_env_split.py iteration --------------------------------
TIKTOK_ACCESS_TRACKING=
TIKTOK_BROWSER_MAX_VIDEOS=
TIKTOK_BROWSER_REVISIT_CLAIM_HOLD_SECONDS=
TIKTOK_BROWSER_REVISIT_CLAIM_TIMEOUT_SECONDS=
TIKTOK_BROWSER_REVISIT_MAX_ATTEMPTS=
TIKTOK_BROWSER_TEMP_DIR=
TIKTOK_COOLDOWN_PROFILE_ONLY_PER_CYCLE=
TIKTOK_DAILY_QUOTA=
TIKTOK_DEFER_UNKNOWN_FOLLOWER_MEDIA_DURING_METADATA_COOLDOWN=
TIKTOK_DOWNLOAD_CONCURRENCY=
TIKTOK_FAMOUS_FOLLOWER_CAP=
TIKTOK_GALLERY_DL_ARCHIVE_DIR=
TIKTOK_GALLERY_DL_ARCHIVE_ENABLED=
TIKTOK_GALLERY_DL_EMPTY_RANGES_BEFORE_RESET=
TIKTOK_GALLERY_DL_RANGE_CURSOR_ENABLED=
TIKTOK_GALLERY_DL_RANGE_DIR=
TIKTOK_GALLERY_DL_RANGE_MAX_START=
TIKTOK_LOCAL_TOOL_429_COOLDOWN_SECONDS=
TIKTOK_METADATA_COOLDOWN_MEDIA_FALLBACKS_PER_CYCLE=
TIKTOK_PROFILE_BACKOFF_DIR=
TIKTOK_PROFILE_BACKOFF_ENABLED=
TIKTOK_PROFILE_EMPTY_BACKOFF_SECONDS=
TIKTOK_PROFILE_FAILURE_BACKOFF_SECONDS=
TIKTOK_PROFILE_TIMEOUT_BACKOFF_SECONDS=
TIKTOK_PROFILE_VIDEO_FOLLOWER_CAP=
TIKTOK_SPIDER_DEPTH=
TIKTOK_SPIDER_ENABLED=
TIKTOK_SPIDER_PROCESSING_STALE_MINUTES=
TIKTOK_SPIDER_QUEUE_FIRST=
TIKTOK_SPIDER_QUEUE_PER_CYCLE=
TIKTOK_TARGETS_PER_CYCLE=
TIKTOK_TRACKER_FILE=
TIKTOK_UNKNOWN_FOLLOWER_METADATA_COOLDOWN_BACKOFF_SECONDS=
TIKTOK_VIDEO_FOLLOWER_CAP=
TIKTOK_YTDLP_AFTER_GALLERY_TIMEOUT=
