# tiktok.env.example - per-service scoped env template.
# Scope: collector_tiktok.
# Rotation: rotating a TikTok cookie or session id touches this file only.
# Copy to tiktok.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Cookie source ----------------------------------------------------------
# Leave TIKTOK_COOKIES_FILE empty to auto-discover credentials/tiktok/tiktok_<user>.txt.
TIKTOK_COOKIES_FILE=  # REQUIRED - set your own secret
TIKTOK_SESSION_ID=

# -- Pacing + retries -------------------------------------------------------
TIKTOK_MIN_SLEEP=
TIKTOK_MAX_SLEEP=
TIKTOK_RETRIES=
TIKTOK_TIMEOUT_SECONDS=

# -- Fallback pipeline toggles ----------------------------------------------
TIKTOK_BROWSER_FALLBACK_ENABLED=
TIKTOK_YTDLP_FALLBACK_ENABLED=
TIKTOK_GALLERY_DL_ENABLED=

# -- Request identity -------------------------------------------------------
TIKTOK_USER_AGENT=

# -- Spider concurrency -----------------------------------------------------
TIKTOK_SPIDER_CONCURRENCY=
