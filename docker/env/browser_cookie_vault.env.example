# browser_cookie_vault.env.example - per-service scoped env template.
# Scope: browser_cookie_vault.
# Rotation: changing snapshot cadence or CDP endpoint touches this file only.
# Copy to browser_cookie_vault.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Vault behaviour --------------------------------------------------------
BROWSER_COOKIE_VAULT_AUTORESTORE=
BROWSER_COOKIE_VAULT_INTERVAL_SECONDS=
BROWSER_COOKIE_VAULT_KEEP_SNAPSHOTS=
BROWSER_COOKIE_VAULT_HEALTH_PORT=

# -- Source Chrome DevTools Protocol endpoint -------------------------------
CHROME_CDP_URL=

# -- Added by verify_env_split.py iteration --------------------------------
BROWSER_COOKIE_VAULT_CDP_WARN_EVERY=
