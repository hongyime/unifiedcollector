# lemon8.env.example - per-service scoped env template.
# Scope: collector_lemon8.
# Rotation: rotating a Lemon8 cookie touches this file only.
# Copy to lemon8.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Cookie source ----------------------------------------------------------
# Leave LEMON8_COOKIES_FILE empty to auto-discover credentials/lemon8/lemon8_<user>.txt.
LEMON8_COOKIES_FILE=  # REQUIRED - set your own secret

# -- Image quality filters --------------------------------------------------
LEMON8_MIN_WIDTH=
LEMON8_MIN_HEIGHT=
LEMON8_MIN_FILE_SIZE=
LEMON8_HIGH_QUALITY_WIDTH=

# -- Feature toggles --------------------------------------------------------
LEMON8_PROFILE_PHOTO_ENABLED=
LEMON8_IMAGE_ENHANCEMENT=

# -- Delay bounds -----------------------------------------------------------
LEMON8_MIN_DELAY=
LEMON8_MAX_DELAY=

# -- FYP feed toggle --------------------------------------------------------
LEMON8_FEED_ENABLED=

# -- Added by verify_env_split.py iteration --------------------------------
LEMON8_ACCESS_TRACKING=
LEMON8_DAILY_QUOTA=
LEMON8_FAMOUS_FOLLOWER_CAP=
LEMON8_OPTIONAL_RATE_LIMIT_SLEEP_CAP_SECONDS=
LEMON8_RATE_LIMIT_COOLDOWN_SECONDS=
LEMON8_RATE_LIMIT_MAX_COOLDOWN_SECONDS=
LEMON8_SOURCE_RATE_LIMIT_SLEEP_CAP_SECONDS=
LEMON8_SPIDER_CONCURRENCY=
LEMON8_SPIDER_DEPTH=
LEMON8_SPIDER_ENABLED=
LEMON8_TAG_PAGES=
