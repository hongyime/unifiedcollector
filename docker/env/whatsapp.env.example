# whatsapp.env.example - per-service scoped env template.
# Scope: collector_whatsapp, wa_bridge_1, wa_bridge_2.
# Rotation: rotating a WhatsApp session or media-bridge secret touches this file only.
# NOTE: RabbitMQ + Redis service passwords live in broker.env; this file
# references them through the URL strings (WHATSAPP_RABBITMQ_URL / WHATSAPP_REDIS_URL).
# Copy to whatsapp.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Offline export reader mode (leave empty when using real-time bridges) --
WHATSAPP_EXPORT_DIR=

# -- Real-time bridge session identity --------------------------------------
WHATSAPP_SESSION_NAMES=
WHATSAPP_MEDIA_BRIDGE_SECRET=  # REQUIRED - set your own secret

# -- Findings hub (per-JID group where collector posts discovery pings) -----
WHATSAPP_FINDINGS_HUB_GROUP_JID=

# -- Broker + cache endpoints -----------------------------------------------
WHATSAPP_RABBITMQ_URL=
WHATSAPP_REDIS_URL=
WHATSAPP_BROKER_TYPE=

# -- Per-session bridge HTTP base URLs (JSON: {session_name: base_url}) -----
WHATSAPP_SESSION_BRIDGES_JSON=

# -- Spider allowlist (comma-separated session names; empty = all) ----------
WHATSAPP_SPIDER_SESSIONS=
