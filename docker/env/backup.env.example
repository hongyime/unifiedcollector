# backup.env.example - per-service scoped env template.
# Scope: backup.
# Rotation: changing backup retention or destination touches this file only.
# NOTE: backup also uses common.env (DB URL) and telegram_notify.env (alerts).
# Copy to backup.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Destination + database identity ----------------------------------------
COLLECTOR_DB_BACKUP_DIR=
COLLECTOR_DB_BACKUP_DATABASE=
COLLECTOR_DB_BACKUP_DOCKER_CONTAINER=

# -- Retention (daily/weekly/monthly slots) ---------------------------------
COLLECTOR_DB_BACKUP_DAILY=
COLLECTOR_DB_BACKUP_WEEKLY=
COLLECTOR_DB_BACKUP_MONTHLY=

# -- Cadence ----------------------------------------------------------------
COLLECTOR_DB_BACKUP_INTERVAL_SECONDS=

# -- Added by verify_env_split.py iteration --------------------------------
COLLECTOR_DB_BACKUP_PREFIX=
