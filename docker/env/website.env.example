# website.env.example - per-service scoped env template.
# Scope: collector_website.
# Rotation: changing the website URL allowlist or depth touches this file only.
# Copy to website.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Crawl controls ---------------------------------------------------------
WEBSITE_MAX_DEPTH=
WEBSITE_MAX_PAGES=
WEBSITE_USE_TOR=
WEBSITE_TIMEOUT=
WEBSITE_MAX_CONCURRENT_TASKS=

# -- URL allowlist (comma-separated glob patterns) --------------------------
WEBSITE_URL_ALLOW=

# -- Added by verify_env_split.py iteration --------------------------------
WEBSITE_AUTODISCOVER_CAP=
WEBSITE_AUTODISCOVER_SCAN=
WEBSITE_AUTODISCOVER_SG=
WEBSITE_DOWNLOAD_DOCS=
WEBSITE_DOWNLOAD_IMAGES=
WEBSITE_DOWNLOAD_PDFS=
WEBSITE_DOWNLOAD_VIDEOS=
WEBSITE_FOLLOW_EXTERNAL=
WEBSITE_MAX_DOC_BYTES=
WEBSITE_MAX_IMAGE_BYTES=
WEBSITE_MAX_PDF_BYTES=
WEBSITE_MAX_VIDEO_BYTES=
WEBSITE_MIN_IMAGE_BYTES=
WEBSITE_MIN_IMAGE_DIM=
WEBSITE_RESPECT_ROBOTS=
WEBSITE_TARGET_CONCURRENCY=
WEBSITE_USE_PLAYWRIGHT=
WEBSITE_VIDEO_CHUNK_BYTES=
