# instagram.env.example - per-service scoped env template.
# Scope: collector_instagram, collector_instagram_dm, ig_ingest.
# Rotation: rotating an IG password touches this file only.
# Copy to instagram.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Account 1 --------------------------------------------------------------
INSTA_ACCOUNT_1_NAME=
INSTA_ACCOUNT_1_USER=
INSTA_ACCOUNT_1_PASS=  # REQUIRED - set your own secret
INSTA_ACCOUNT_1_BROWSER=

# -- Account 2 --------------------------------------------------------------
INSTA_ACCOUNT_2_NAME=
INSTA_ACCOUNT_2_USER=
INSTA_ACCOUNT_2_PASS=  # REQUIRED - set your own secret
INSTA_ACCOUNT_2_BROWSER=

# -- Account 3 --------------------------------------------------------------
INSTA_ACCOUNT_3_NAME=
INSTA_ACCOUNT_3_USER=
INSTA_ACCOUNT_3_PASS=  # REQUIRED - set your own secret
INSTA_ACCOUNT_3_BROWSER=

# -- Account 4 --------------------------------------------------------------
INSTA_ACCOUNT_4_NAME=
INSTA_ACCOUNT_4_USER=
INSTA_ACCOUNT_4_PASS=  # REQUIRED - set your own secret
INSTA_ACCOUNT_4_BROWSER=

# -- Account 5 --------------------------------------------------------------
INSTA_ACCOUNT_5_NAME=
INSTA_ACCOUNT_5_USER=
INSTA_ACCOUNT_5_PASS=  # REQUIRED - set your own secret
INSTA_ACCOUNT_5_BROWSER=

# -- Account 6 --------------------------------------------------------------
INSTA_ACCOUNT_6_NAME=
INSTA_ACCOUNT_6_USER=
INSTA_ACCOUNT_6_PASS=  # REQUIRED - set your own secret
INSTA_ACCOUNT_6_BROWSER=

# -- Collection filters -----------------------------------------------------
FILTER_MAX_FOLLOWERS=

# -- Sliding-window rate limits ---------------------------------------------
SLIDING_WINDOW_ENABLED=
INSTA_WINDOW_1H=
INSTA_WINDOW_3H=
INSTA_WINDOW_5H=
INSTA_WINDOW_1D=

# -- Content-aware delays ---------------------------------------------------
CONTENT_AWARE_ENABLED=

# -- Daily quota per account (0 = unlimited) --------------------------------
INSTA_DAILY_QUOTA_PROFILE_VIEWS=
INSTA_DAILY_QUOTA_ACTIONS=

# -- Warmup (3x 30-60s pauses before collection) ----------------------------
INSTA_WARMUP_ENABLED=

# -- Proxy override (Tor causes 429 on Instagram; keep disabled) ------------
INSTA_PROXY_DISABLED=

# -- Headless retry cadence when browser extension is fresh -----------------
INSTAGRAM_IDLE_SECONDS=

# -- Added by verify_env_split.py iteration --------------------------------
INSTA_ACCESS_TRACKING=
INSTA_DOWNLOAD_GEOTAGS=
INSTA_EXTENSION_FRESH_MEDIA_SECONDS=
INSTA_EXTENSION_FRESH_REQUIRE_STORED_MEDIA=
INSTA_GRAPHQL_POSTS_DISABLE_ON_400=
INSTA_GRAPHQL_POSTS_DISABLE_SECONDS=
INSTA_GRAPHQL_POSTS_ENABLED=
INSTA_LOGIN_PRIORITY=
INSTA_MAX_FOLLOWERS_PER_SESSION=
INSTA_MAX_POSTS_PER_USER=
INSTA_MAX_REELS_PER_USER=
INSTA_MAX_SAVED=
INSTA_MAX_TAGGED_PER_USER=
INSTA_MULTI_GRAPH_DELAY_MAX=
INSTA_MULTI_GRAPH_DELAY_MIN=
INSTA_MULTI_GRAPH_ENABLED=
INSTA_MULTI_GRAPH_INTERVAL_HOURS=
INSTA_MULTI_GRAPH_MAX=
INSTA_MULTI_GRAPH_MAX_PAGES=
INSTA_OWN_GRAPH_ENABLED=
INSTA_OWN_GRAPH_INTERVAL_HOURS=
INSTA_OWN_GRAPH_MAX=
INSTA_PLAYWRIGHT_PRIMARY=
INSTA_SESSION_MAX_AGE_DAYS=
INSTA_SPIDER_HOPS=
INSTA_SPIDER_MAX_FOLLOWERS=
INSTA_SPIDER_MAX_FOLLOWING=
INSTA_TARGET_TIMEOUT_MAX_SECONDS=
INSTA_TARGET_TIMEOUT_SECONDS=
INSTA_TLS_COOLDOWN_SECS=
INSTA_TLS_IMPERSONATE_POOL=
