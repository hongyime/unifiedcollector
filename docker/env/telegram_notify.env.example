# telegram_notify.env.example - per-service scoped env template.
# Scope: scheduler, realtime_feed, watchdog, backup, collector_telegram.
# Rotation: rotating the alert bot token touches this file only.
# NOTE: this is the SEND-ONLY alert bot, distinct from the collector bot
# tokens in telegram.env and the onboarding bot tokens in telegram_onboard.env.
# A compromised alert channel cannot affect collection.
# Copy to telegram_notify.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Alert bot --------------------------------------------------------------
NOTIFY_TELEGRAM_BOT_TOKEN=  # REQUIRED - set your own secret
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_TELEGRAM_THREAD_ID=

# -- Fallback chat id (used when NOTIFY_TELEGRAM_CHAT_ID is unset) ----------
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# -- Self-bot ingest guard (see notes in root .env.example) -----------------
UC_NOTIFY_BOT_USER_ID=
TELEGRAM_LOGS_CHAT_ID=

# -- Heartbeat cadence ------------------------------------------------------
STATUS_HEARTBEAT_INTERVAL_HOURS=
STATUS_DELTA_INTERVAL_MINUTES=
