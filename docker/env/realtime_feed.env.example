# realtime_feed.env.example - per-service scoped env template.
# Scope: realtime_feed, scheduler (reads REALTIME_POST_FEED_* to decide enqueue).
# Rotation: changing feed rate limits or dedupe windows touches this file only.
# NOTE: this file holds ONLY feed-daemon knobs. The Telegram bot token the
# feed uses to post lives in telegram_notify.env; the Redis URL lives in
# broker.env / whatsapp.env (WHATSAPP_REDIS_URL is shared for the queue).
# Copy to realtime_feed.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Master toggle ----------------------------------------------------------
REALTIME_POST_FEED_ENABLED=

# -- Rate limit -------------------------------------------------------------
REALTIME_POST_FEED_MAX_PER_MINUTE=

# -- Dedupe windows ---------------------------------------------------------
REALTIME_POST_FEED_DEDUPE_TTL_DAYS=
REALTIME_POST_FEED_DEDUPE_BY_MEDIA=

# -- Content filters --------------------------------------------------------
REALTIME_POST_FEED_INCLUDE_PROFILES=
REALTIME_POST_FEED_SKIP_VIDEO_THUMBNAILS=

# -- Burst summary (posted when rate cap engages) ---------------------------
REALTIME_POST_FEED_BURST_SUMMARY=
REALTIME_POST_FEED_BURST_SUMMARY_SECONDS=
