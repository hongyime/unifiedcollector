# strava.env.example - per-service scoped env template.
# Scope: collector_lowrisk.
# Rotation: rotating a Strava session cookie touches this file only.
# Copy to strava.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Session cookie source --------------------------------------------------
# Leave STRAVA_COOKIES_FILE empty to auto-discover credentials/strava/strava_<user>.txt.
STRAVA_COOKIES_FILE=  # REQUIRED - set your own secret
STRAVA_COLLECTOR_ENABLED=
STRAVA_SESSION_COOKIE=  # REQUIRED - set your own secret

# -- OAuth mode (optional; developers.strava.com) ---------------------------
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REFRESH_TOKEN=

# -- API delay bounds -------------------------------------------------------
STRAVA_API_DELAY_MIN=  # REQUIRED - set your own secret
STRAVA_API_DELAY_MAX=  # REQUIRED - set your own secret

# -- Feed delay bounds ------------------------------------------------------
STRAVA_FEED_DELAY_MIN=
STRAVA_FEED_DELAY_MAX=

# -- Backfill delay + parallelism -------------------------------------------
STRAVA_BACKFILL_DELAY_MIN=
STRAVA_BACKFILL_DELAY_MAX=
STRAVA_BACKFILL_STEPS=
STRAVA_BACKFILL_PARALLELISM=

# -- GPS backfill + route repair --------------------------------------------
STRAVA_GPS_BACKFILL_FIRST=
STRAVA_GPS_BACKFILL_BATCH=
STRAVA_GPS_ROUTE_REPAIR_BATCH=

# -- DB blob storage cap for profile photos ---------------------------------
STRAVA_PROFILE_PHOTO_BLOB_MAX_SIZE_MB=

# -- Added by verify_env_split.py iteration --------------------------------
STRAVA_BROWSER_429_COOLDOWN_SECONDS=
STRAVA_BROWSER_429_MAX_COOLDOWN_SECONDS=
STRAVA_BROWSER_429_MEMORY_SECONDS=
STRAVA_BROWSER_ROUTE_QUEUE_CANDIDATE_LIMIT=
STRAVA_BROWSER_ROUTE_QUEUE_IMPORTANT_CANDIDATE_LIMIT=
STRAVA_BROWSER_ROUTE_RESPECT_GPS_COOLDOWN=
STRAVA_BROWSER_ROUTE_VISIT_TTL_HOURS=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_CLUB_MEMBER_PAGES=
STRAVA_FEED_BACKFILL_ENABLED=
STRAVA_FEED_MAX_PAGES=
STRAVA_GPS_ENABLED=
STRAVA_GPS_FETCH_FAILURE_BACKOFF_HOURS=
STRAVA_OWNER_ROSTER_MAX_PAGES=
STRAVA_PHOTO_BACKFILL_BATCH=
STRAVA_PHOTO_BACKFILL_FIRST=
STRAVA_PRIVACY_BACKFILL_BATCH=
STRAVA_RATELIMIT_SLEEP=
STRAVA_REFRESH_TOKEN=
STRAVA_REQUIRE_MEDIA_OR_MAP=
STRAVA_ROSTER_SEED_TARGETS=
STRAVA_ROUTE_QUEUE_RESPONSE_CACHE_SECONDS=
STRAVA_ROUTE_QUEUE_RESPONSE_TIMEOUT_SECONDS=
STRAVA_ROUTE_QUEUE_TIMEOUT_WARN_SECONDS=
STRAVA_ROUTE_STREAM_SHARED_COOLDOWN=
STRAVA_STREAM_RATELIMIT_MAX_SLEEP=
STRAVA_STREAM_RATELIMIT_MEMORY_SECONDS=
STRAVA_STREAM_RATELIMIT_SLEEP=
STRAVA_TRAINING_MAX_PAGES=
