# github.env.example - per-service scoped env template.
# Scope: collector_lowrisk.
# Rotation: rotating a GitHub PAT touches this file only.
# Copy to github.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- PATs (comma-separated for rotation across multiple tokens) -------------
GITHUB_TOKEN=  # REQUIRED - set your own secret

# -- Avatar rendering + pacing ----------------------------------------------
GITHUB_AVATAR_SIZE=
GITHUB_API_DELAY=  # REQUIRED - set your own secret
GITHUB_MAX_CONCURRENT=
GITHUB_TARGET_CONCURRENCY=

# -- Spider controls --------------------------------------------------------
GITHUB_SPIDER_CONCURRENCY=
GITHUB_SPIDER_BATCH_SIZE=
GITHUB_SPIDER_DEPTH=
GITHUB_SPIDER_USER_DELAY=

# -- Per-repo caps ----------------------------------------------------------
GITHUB_MAX_COMMITS_PER_REPO=
GITHUB_MAX_ISSUES_PER_REPO=
GITHUB_MAX_CONTRIBUTORS_PER_REPO=

# -- Download pacing --------------------------------------------------------
GITHUB_DOWNLOAD_DELAY=

# -- DB blob storage cap for profile photos ---------------------------------
GITHUB_PROFILE_PHOTO_BLOB_MAX_SIZE_MB=

# -- Added by verify_env_split.py iteration --------------------------------
GITHUB_ASSET_OWNER_LOGIN=
GITHUB_FAMOUS_FILTER_USERS=
GITHUB_FAMOUS_STAR_CAP=
GITHUB_OWNER_ACCOUNTS=
GITHUB_PAT=
GITHUB_PROFILE_PHOTO_BLOB_ENABLED=
GITHUB_RATE_LIMIT_BUFFER=
GITHUB_RATE_LIMIT_DEFAULT_COOLDOWN_SECONDS=
GITHUB_RATE_LIMIT_MAX_SLEEP_SECONDS=
GITHUB_SPIDER_ENABLED=
GITHUB_SPIDER_SEED=
GITHUB_USE_TOR=
