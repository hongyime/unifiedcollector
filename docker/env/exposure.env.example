# exposure.env.example - per-service scoped env template.
# Scope: collector_exposure.
# Rotation: changing exposure allowlist or query cap touches this file only.
# NOTE: exposure also depends on search.env (Tor proxy + search API key).
# Copy to exposure.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Master toggle ----------------------------------------------------------
EXPOSURE_ENABLED=

# -- Domain scope + regex allowlist -----------------------------------------
EXPOSURE_ALLOWED_DOMAINS=
EXPOSURE_ALLOWED_REGEX=

# -- Query cap per collection cycle -----------------------------------------
EXPOSURE_MAX_QUERIES_PER_CYCLE=
