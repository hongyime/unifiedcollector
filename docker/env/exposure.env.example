# exposure.env.example - per-service scoped env template.
# Scope: collector_exposure.
# Rotation: changing exposure allowlist or query cap touches this file only.
# NOTE: exposure shares the search adapter and keeps bounded search settings here.
# Copy to exposure.env and fill in values; Compose loads this file for exposure.

# -- Master toggle ----------------------------------------------------------
EXPOSURE_ENABLED=1

# -- Domain scope + regex allowlist -----------------------------------------
EXPOSURE_ALLOWED_DOMAINS=*.edu.sg,*.sg,*.com,*.me,*.kr,*.*
EXPOSURE_ALLOWED_REGEX=.*

# -- Query cap per collection cycle -----------------------------------------
EXPOSURE_MAX_QUERIES_PER_CYCLE=9999

# Shared search retry ceiling used by exposure's bounded search adapter.
SEARCH_RATE_LIMIT_MAX_COOLDOWN_SECONDS=21600

# Well-known metadata scan bounds.
WELL_KNOWN_GLOBAL_HOURLY_CAP=500
WELL_KNOWN_HOST_QPS=2
WELL_KNOWN_MAX_CONTENT_BYTES=102400
WELL_KNOWN_MIN_LINKS=3
WELL_KNOWN_SITEMAP_URL_CAP=500
WELL_KNOWN_TIMEOUT_SECONDS=10
