# youtube.env.example - per-service scoped env template.
# Scope: collector_youtube.
# Rotation: rotating a YouTube API key or OAuth secret touches this file only.
# Copy to youtube.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Data API v3 key --------------------------------------------------------
YOUTUBE_API_KEY=  # REQUIRED - set your own secret

# -- OAuth client (used by yt-dlp cookie extraction + Data API v3) ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=  # REQUIRED - set your own secret

# -- Cookie source (auto / chrome / edge / firefox) -------------------------
YOUTUBE_COOKIE_BROWSER=  # REQUIRED - set your own secret
YOUTUBE_COOKIE_FILE=  # REQUIRED - set your own secret

# -- Download filters + format ----------------------------------------------
YOUTUBE_MAX_VIDEO_DURATION_MINUTES=
YOUTUBE_YTDLP_FORMAT=

# -- Rate limits ------------------------------------------------------------
YOUTUBE_DOWNLOAD_DELAY=
YOUTUBE_API_DELAY=  # REQUIRED - set your own secret
YOUTUBE_MAX_CONCURRENT_DOWNLOADS=

# -- DB blob storage cap for profile photos ---------------------------------
YOUTUBE_PROFILE_PHOTO_BLOB_MAX_SIZE_MB=

# -- Added by verify_env_split.py iteration --------------------------------
YOUTUBE_API_403_COOLDOWN_SECONDS=
YOUTUBE_API_429_COOLDOWN_SECONDS=
YOUTUBE_API_DAILY_QUOTA=
YOUTUBE_API_KEYS=
YOUTUBE_COMMUNITY_BATCH=
YOUTUBE_COMMUNITY_ENABLED=
YOUTUBE_COMPLETENESS_TTL_SECONDS=
YOUTUBE_DAILY_QUOTA_UNITS=
YOUTUBE_DISCOVERED_TARGET_PRIORITY=
YOUTUBE_DOWNLOAD_VIDEOS=
YOUTUBE_FAMOUS_SUB_CAP=
YOUTUBE_FETCH_COMMENTS=
YOUTUBE_FETCH_TRANSCRIPTS=
YOUTUBE_MAX_COMMENTS=
YOUTUBE_MAX_COMMENT_AUTHOR_ENQUEUES=
YOUTUBE_MAX_LIKED_VIDEOS=
YOUTUBE_MAX_REFS_PER_RECORD=
YOUTUBE_MAX_SUBSCRIPTIONS=
YOUTUBE_MAX_VIDEOS_PER_CHANNEL=
YOUTUBE_MEDIA_BACKLOG_QUERY_TIMEOUT_SECONDS=
YOUTUBE_MEDIA_BACKLOG_TTL_SECONDS=
YOUTUBE_MERGE_FORMAT=
YOUTUBE_OAUTH_PICKLE=
YOUTUBE_PREFILL_MEDIA_BACKLOG=
YOUTUBE_PROFILE_QUEUE_ENABLED=
YOUTUBE_PROFILE_QUEUE_MAX_ATTEMPTS=
YOUTUBE_SEARCH_DAILY_QUOTA_UNITS=
YOUTUBE_SPIDER_AUTOTARGET=
YOUTUBE_SPIDER_ENABLED=
YOUTUBE_SPIDER_REFRESH_AFTER_HOURS=
YOUTUBE_SPIDER_RETRY_FAILED_AFTER_HOURS=
YOUTUBE_SUBSCRIPTION_CACHE=
YOUTUBE_TARGET_CHANNELS_FILE=
YOUTUBE_TRANSCRIPT_LANG=
