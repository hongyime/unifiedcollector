# search.env.example - per-service scoped env template.
# Scope: collector_search.
# Rotation: rotating a search API key or Tor proxy URL touches this file only.
# Copy to search.env and fill in values; Compose loads it for search. Exposure uses bounded search defaults.

# -- Search API (dead/deprecated Serper, kept for env parity) ---------------
SEARCH_API_KEY=  # REQUIRED - set your own secret

# -- DuckDuckGo transient error retry ----------------------------------------
SEARCH_DDG_RETRIES=3
SEARCH_DDG_TIMEOUT=30
SEARCH_DDG_RETRY_BASE_SECONDS=2.0

# -- Media quality filters --------------------------------------------------
SEARCH_MIN_DIMENSION=
SEARCH_MIN_FILE_SIZE=

# -- Result cache -----------------------------------------------------------
SEARCH_CACHE_TTL_HOURS=

# -- Concurrency -----------------------------------------------------------
SEARCH_CONCURRENT_DOWNLOADS=
# Configured/discovered seeds processed per cycle (default 10; clamped 1-100).
SEARCH_MAX_TARGETS_PER_CYCLE=10

# -- Tor SOCKS5 sidecar (backs /search after Serper deprecation) ------------
SEARCH_TOR_PROXY=
PROXY_URL=

# -- Added by verify_env_split.py iteration --------------------------------
SEARCH_BUCKET_MAX_KEYS=
SEARCH_BUCKET_MAX_PAGES=
SEARCH_DOWNLOAD_DOCS=
SEARCH_DOWNLOAD_IMAGES=
SEARCH_DOWNLOAD_VIDEOS=
SEARCH_MAX_DOC_BYTES=
SEARCH_DOCUMENT_INDEX_ENABLED=
SEARCH_MAX_DOCUMENT_TEXT_CHARS=
SEARCH_MAX_DOCUMENT_ARCHIVE_BYTES=
SEARCH_MAX_PDF_PAGES=
SEARCH_MAX_VIDEO_BYTES=
SEARCH_RATE_LIMIT_COOLDOWN_SECONDS=
SEARCH_RATE_LIMIT_MAX_COOLDOWN_SECONDS=21600
SEARCH_SERPER_THRESHOLD=
SEARCH_SPIDER_DEPTH=
SEARCH_SPIDER_PAGES=
SEARCH_VIDEO_CHUNK_BYTES=
SEARCH_DYNAMIC_TERMS_ENABLED=
SEARCH_DYNAMIC_TERM_CAP=
SEARCH_DYNAMIC_TERM_TTL_DAYS=7
SEARCH_DYNAMIC_REFRESH_HOURS=0
SEARCH_DYNAMIC_QUERY_INTERVAL_DAYS=0
SEARCH_DYNAMIC_SOURCE_ROWS=
