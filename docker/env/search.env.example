# search.env.example - per-service scoped env template.
# Scope: collector_lowrisk, collector_exposure.
# Rotation: rotating a search API key or Tor proxy URL touches this file only.
# Copy to search.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Search API (dead/deprecated Serper, kept for env parity) ---------------
SEARCH_API_KEY=  # REQUIRED - set your own secret

# -- Media quality filters --------------------------------------------------
SEARCH_MIN_DIMENSION=
SEARCH_MIN_FILE_SIZE=

# -- Result cache -----------------------------------------------------------
SEARCH_CACHE_TTL_HOURS=

# -- Concurrency -----------------------------------------------------------
SEARCH_CONCURRENT_DOWNLOADS=

# -- Tor SOCKS5 sidecar (backs /search after Serper deprecation) ------------
SEARCH_TOR_PROXY=
PROXY_URL=

# -- Added by verify_env_split.py iteration --------------------------------
SEARCH_BUCKET_MAX_KEYS=
SEARCH_BUCKET_MAX_PAGES=
SEARCH_DOWNLOAD_DOCS=
SEARCH_DOWNLOAD_IMAGES=
SEARCH_DOWNLOAD_VIDEOS=
SEARCH_MAX_DOC_BYTES=
SEARCH_MAX_PDF_PAGES=
SEARCH_MAX_VIDEO_BYTES=
SEARCH_RATE_LIMIT_COOLDOWN_SECONDS=
SEARCH_SERPER_THRESHOLD=
SEARCH_SPIDER_DEPTH=
SEARCH_SPIDER_PAGES=
SEARCH_VIDEO_CHUNK_BYTES=
