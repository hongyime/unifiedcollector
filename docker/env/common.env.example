# common.env.example - per-service scoped env template.
# Scope: ALL services (shared DB + storage + timezone).
# Rotation: rotating the DB password touches this file only.
# Copy to common.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Database (shared by every container that connects to postgres) ---------
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=  # REQUIRED - set your own secret
POSTGRES_HOST_PORT=
POSTGRES_SSL_MODE=
POSTGRES_SSL_CERT=

# -- Storage (shared media / vault / sidecar mount points) ------------------
COLLECTOR_DRIVE_PATH=
COLLECTOR_VAULT_ROOT=
COLLECTOR_SIDECARS_ENABLED=

# -- Timezone (shared runtime setting) --------------------------------------
TZ=

