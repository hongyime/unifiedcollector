# telegram_onboard.env.example - per-service scoped env template.
# Scope: onboard_bot.
# Rotation: rotating an onboarding bot token touches this file only.
# NOTE: these are the /startcollector onboarding BOT tokens (from @BotFather),
# distinct from the MTProto collector accounts in telegram.env and the alert
# bot in telegram_notify.env.
# Copy to telegram_onboard.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Per-account onboarding bot tokens --------------------------------------
PRAWNPRODUCTIONS_BOT_TOKEN=  # REQUIRED - set your own secret
SHOTSBYSEAH_BOT_TOKEN=  # REQUIRED - set your own secret
BRYANSEAH_BOT_TOKEN=  # REQUIRED - set your own secret

# -- Auto-backfill toggle for freshly onboarded accounts --------------------
TELEGRAM_AUTO_BACKFILL_NEW_ACCOUNTS=
