# beeper.env.example - per-service scoped env template.
# Scope: collector_beeper.
# Rotation: rotating the Beeper Desktop API token touches this file only.
# Copy to beeper.env and fill in values. Wiring into compose is deferred; see docker/env/README.md.

# -- Beeper Desktop Local API -----------------------------------------------
BEEPER_DESKTOP_API_URL=  # REQUIRED - set your own secret
BEEPER_DESKTOP_API_TOKEN=  # REQUIRED - set your own secret

# -- Collector toggle -------------------------------------------------------
BEEPER_COLLECTOR_ENABLED=
