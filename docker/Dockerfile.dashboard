# Reuse the proven collector runtime instead of reinstalling the full shared
# dependency lockfile for the API-only dashboard image.
FROM unifiedcollector-collector:latest

WORKDIR /app

COPY src/ src/
COPY dashboard/frontend/dist/ dashboard/frontend/dist/

CMD ["uvicorn", "src.dashboard.api:app", "--host", "0.0.0.0", "--port", "8700"]
