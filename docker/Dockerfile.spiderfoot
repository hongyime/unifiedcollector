FROM python:3.11-slim

WORKDIR /app

ARG SPIDERFOOT_VERSION=4.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates wget build-essential swig \
    libffi-dev libssl-dev libxml2-dev libxslt1-dev zlib1g-dev \
    libjpeg-dev libopenjp2-7-dev \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir asyncpg==0.31.0

# maigret: HTTP-only OSS account-enumeration engine (MIT). Replaces the DEAD
# sfp_accounts module as the recon username handler. Installed into the system
# python (NOT /opt/spiderfoot-venv) so the recon worker (which imports asyncpg
# from the system python) can invoke `maigret` as a bounded subprocess. This is
# HTTP-only by design: no --cloudflare-bypass, no browser, no headless anything.
RUN pip install --no-cache-dir maigret==0.5.0

RUN wget -q -O /tmp/spiderfoot.tar.gz "https://github.com/smicallef/spiderfoot/archive/v${SPIDERFOOT_VERSION}.tar.gz" \
 && tar -xzf /tmp/spiderfoot.tar.gz -C /opt \
 && mv "/opt/spiderfoot-${SPIDERFOOT_VERSION}" /opt/spiderfoot \
 && python -m venv /opt/spiderfoot-venv \
 && /opt/spiderfoot-venv/bin/pip install --no-cache-dir "pip<25" "setuptools<70" wheel "Cython<3" \
 && /opt/spiderfoot-venv/bin/pip install --no-cache-dir --no-build-isolation "PyYAML==5.4.1" \
 && /opt/spiderfoot-venv/bin/pip install --no-cache-dir -r /opt/spiderfoot/requirements.txt \
 && printf '#!/bin/sh\nexec /opt/spiderfoot-venv/bin/python /opt/spiderfoot/sf.py "$@"\n' > /usr/local/bin/spiderfoot-cli \
 && chmod +x /usr/local/bin/spiderfoot-cli \
 && rm -f /tmp/spiderfoot.tar.gz

# Pilot: fix schema drift in SpiderFoot v4.0's sfp_accounts module against the
# current upstream WhatsMyName data (data URL renamed, `valid` field removed,
# `check_uri`/`category` renamed to `uri_check`/`cat`). Idempotent, safe to
# re-run. This makes sfp_accounts FUNCTIONAL if enabled; it does NOT enable
# it — the SPIDERFOOT_MODULES / RECON_USERNAME_MODULES env + per-target scope
# still control activation, and the intrusive-module block stays in place.
COPY docker/patches/sfp_accounts_schema_drift.py /tmp/sfp_accounts_patch.py
RUN python /tmp/sfp_accounts_patch.py && rm -f /tmp/sfp_accounts_patch.py

COPY src/ src/
COPY config/ config/

ENV SPIDERFOOT_CLI="/usr/local/bin/spiderfoot-cli"

CMD ["python", "-m", "src.recon_spiderfoot_service"]
