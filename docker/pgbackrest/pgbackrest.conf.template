; pgBackRest configuration template — Phase 0 (dry-run only).
;
; Live config is generated by the sidecar entrypoint from this template
; plus env-driven values at container start. The template is checked in;
; the rendered config is regenerated on every service (re)start so
; credential edits stay in env_file / secrets and never leak to git.
;
; See docs/plans/backup-modernization-pgbackrest.md for the migration
; plan. Phase 0 = this file + a dry-run sidecar. No pg_basebackup fired
; against the live cluster yet.

[global]
; Repository target — Phase 0 uses a local Z: bind for validation; Phase 2
; switches to Cloudflare R2 (repo1-type=s3 + repo1-s3-*).
repo1-path=/var/lib/pgbackrest
repo1-cipher-type=none                    ; TODO Phase 2: aes-256-cbc + repo1-cipher-pass
repo1-retention-full=2
repo1-retention-diff=2

; Parallelism + compression. pgBackRest defaults are conservative;
; on a 4-core machine with zstd-3, expect 3-5x throughput over the
; current single-thread gzip:1 path.
process-max=4
compress-type=zst
compress-level=3

; Delta restore + reasonable timeouts.
delta=y
protocol-timeout=1800
db-timeout=600

; Where pgBackRest expects the logs to land inside the sidecar.
log-path=/var/log/pgbackrest
log-level-console=info
log-level-file=info

; The stanza — one per Postgres cluster we back up. "main" for now.
[main]
pg1-host=postgres
pg1-port=5432
pg1-database=unifiedcollector
pg1-user=collector
; pg1-password comes from env (PGPASSWORD or a .pgpass mount).
pg1-path=/var/lib/postgresql/data
