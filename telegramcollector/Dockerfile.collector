FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install only what the collector needs (no insightface/onnxruntime)
RUN pip install --no-cache-dir \
    telethon==1.36.0 \
    psycopg[binary]==3.1.18 \
    psycopg-pool==3.2.1 \
    numpy==1.26.4 \
    python-dotenv==1.0.1 \
    redis==5.0.1 \
    pgvector==0.2.5 \
    Pillow==12.1.1 \
    streamlit==1.54.0 \
    pandas==2.2.1 \
    altair==5.2.0 \
    watchdog==4.0.0 \
    requests==2.33.0 \
    aiofiles==23.2.1 \
    pydantic-settings==2.2.1 \
    prometheus_client==0.20.0 \
    python-json-logger==2.0.7 \
    psutil==5.9.8 \
    av>=13.0.0 \
    asyncpg==0.29.0 \
    psycopg2-binary==2.9.9 \
    protobuf==5.29.6

COPY shared/ shared/
COPY services/collector/ services/collector/
COPY services/index/ services/index/
COPY worker.py worker.py

RUN mkdir -p sessions logs

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

CMD ["python", "-m", "services.collector.main"]
