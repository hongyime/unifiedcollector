FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    psycopg[binary]==3.1.18 \
    psycopg-pool==3.2.1 \
    python-dotenv==1.0.1 \
    redis==5.0.1 \
    pgvector==0.2.5 \
    streamlit==1.54.0 \
    pandas==2.2.1 \
    pydantic-settings==2.2.1 \
    prometheus_client==0.20.0 \
    python-json-logger==2.0.7 \
    numpy==1.26.4 \
    asyncpg==0.29.0 \
    psycopg2-binary==2.9.9

COPY services/face_recognition/ services/face_recognition/
COPY shared/ shared/

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

EXPOSE 8502

CMD ["streamlit", "run", "services/face_recognition/dashboard/app.py", "--server.port=8502", "--server.address=0.0.0.0"]
