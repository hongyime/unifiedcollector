# ── Strava Toolkit Environment Variables ──────────────────────────────────────
# Copy relevant variables to your shell environment or a .env loader.
# data/.env is managed automatically (session cookie only).

# ── Scraping behaviour ─────────────────────────────────────────────────────────
BACKFILL_STEPS=25                   # Max athlete-month steps per backfill run
BACKFILL_PARALLELISM=3              # Concurrent athletes during backfill
BACKFILL_YEAR_CAP=25                # Stop backfill this many years in the past

# ── Delay tuning (seconds) ─────────────────────────────────────────────────────
API_DELAY_MIN_SECONDS=5.0
API_DELAY_MAX_SECONDS=10.0
FEED_DELAY_MIN_SECONDS=5.0
FEED_DELAY_MAX_SECONDS=12.0
BACKFILL_DELAY_MIN_SECONDS=5.0
BACKFILL_DELAY_MAX_SECONDS=15.0
STREAM_DELAY_MIN_SECONDS=5.0
STREAM_DELAY_MAX_SECONDS=8.0
ROSTER_DELAY_MIN_SECONDS=5.0
ROSTER_DELAY_MAX_SECONDS=10.0

# ── Rate limit / HTTP ──────────────────────────────────────────────────────────
RATE_LIMIT_RETRIES=2
RATE_LIMIT_BACKOFF_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20
AUTH_RECOVERY_BACKOFF_SECONDS=30
AUTH_RECOVERY_BACKOFF_CAP_SECONDS=300

# ── Photo blobs ────────────────────────────────────────────────────────────────
PROFILE_PHOTO_BLOB_MAX_SIZE_MB=5000  # Max DB size before skipping blob storage

# ── Frontend map tiles ─────────────────────────────────────────────────────────
STADIA_MAPS_API_KEY=                 # Free key at stadiamaps.com

# ── Debug flags ────────────────────────────────────────────────────────────────
DEBUG_HTTP=false
DEBUG_DELAYS=false
