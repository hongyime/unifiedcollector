# YouTube Toolkit Configuration

# Logging
YOUTUBE_LOG_LEVEL=INFO

# YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_LIMIT=10000

# OAuth 2.0 (for private subscriptions and liked videos)
# Leave empty to use interactive OAuth flow
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Download settings
YOUTUBE_DOWNLOAD_PATH=downloads
YOUTUBE_MAX_CONCURRENT_DOWNLOADS=3
YOUTUBE_MAX_VIDEO_DURATION_MINUTES=0  # 0 = no limit, otherwise only download videos shorter than X minutes

# Rate limiting (increased to avoid 429 errors)
YOUTUBE_API_DELAY_SECONDS=3.0
YOUTUBE_DOWNLOAD_DELAY_SECONDS=5.0

# Cookie authentication (helps avoid 429s)
YOUTUBE_USE_COOKIES=true
YOUTUBE_COOKIE_BROWSER=auto  # auto, chrome, edge, firefox

# Profile photo blob storage limit (MB)
YOUTUBE_PROFILE_PHOTO_BLOB_MAX_SIZE_MB=5000

# yt-dlp settings
YOUTUBE_YTDLP_FORMAT=best
YOUTUBE_YTDLP_RETRIES=3

# Database
YOUTUBE_DB_PATH=data/youtube_data.db

# Flask web interface
YOUTUBE_WEB_HOST=127.0.0.1
YOUTUBE_WEB_PORT=5000
