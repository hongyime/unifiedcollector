# Website Toolkit Configuration

# Logging level (DEBUG, INFO, WARNING, ERROR)
WEBSITE_LOG_LEVEL=INFO

# HTTP request timeout (seconds)
WEBSITE_TIMEOUT=30

# Maximum concurrent download tasks
WEBSITE_MAX_CONCURRENT_TASKS=5

# Feature flags
WEBSITE_FEATURE_PHOTO_SCRAPER=true
WEBSITE_FEATURE_LINK_SPIDER=true
WEBSITE_FEATURE_PROXY_MANAGEMENT=true

# Search engine API keys (optional)
SERPER_API_KEY=

# Tor configuration
USE_TOR=false
