# TikTok Toolkit environment template
# Copy to .env and adjust as needed

# Base output directory
TIKTOK_OUTPUT_ROOT=downloads

# Logging level (DEBUG, INFO, WARNING, ERROR)
TIKTOK_LOG_LEVEL=INFO

# Cookies
TIKTOK_COOKIES_FILE=configs/tiktok_cookies.txt
TIKTOK_COOKIES_BROWSER=

# Download tracker database and backup
TIKTOK_DB_PATH=data/tiktok_toolkit.db
TIKTOK_TRACKER_JSON_BACKUP=configs/download_tracker.json.backup
TIKTOK_TRACKER_REQUIRED=true
TIKTOK_SKIP_EXISTING=true

# Timing / retries
TIKTOK_MIN_SLEEP=0.5
TIKTOK_MAX_SLEEP=2.0
TIKTOK_RETRIES=2
TIKTOK_TIMEOUT_SECONDS=300

# Browser / fallback toggles
TIKTOK_BROWSER_FALLBACK_ENABLED=true
TIKTOK_YTDLP_FALLBACK_ENABLED=true

# Optional request fingerprint override
TIKTOK_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
