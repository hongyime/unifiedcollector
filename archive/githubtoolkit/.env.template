# GitHub Toolkit Configuration Template
# Copy this file to .env and fill in your values

# GitHub Personal Access Token(s) — comma-separated for multiple tokens
# Each token adds 5000 requests/hour. Scopes: read:user, user:follow
# Leave empty for unauthenticated mode (60 requests/hour)
# e.g. GITHUB_PAT=ghp_abc123,ghp_def456
GITHUB_PAT=

# Maximum users to collect (safety limit to prevent unbounded growth)
GITHUB_MAX_USERS=50000

# Avatar download settings
AVATAR_SIZE=460
AVATAR_DOWNLOAD_DELAY=0.5

# API request settings
API_REQUEST_DELAY=0.1
API_RATE_LIMIT_BUFFER=10

# Concurrency settings
MAX_CONCURRENT_DOWNLOADS=10
MAX_CONCURRENT_API_REQUESTS=5

# Spider settings
DEFAULT_SPIDER_DEPTH=3

# Photo blob storage (in MB)
PROFILE_PHOTO_BLOB_MAX_SIZE_MB=5000

# Flask web server settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=False

# Logging
LOG_LEVEL=INFO
