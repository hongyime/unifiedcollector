# ==========================================
# whatsappcollector - Environment Variables
# ==========================================
# Copy this file to .env and fill required values.

# ------------------------------------------
# Infrastructure
# ------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=whatsappcollector
POSTGRES_USER=wac_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_SSL_MODE=require
POSTGRES_SSL_ROOT_CERT=
POSTGRES_SSL_CLIENT_CERT=
POSTGRES_SSL_CLIENT_KEY=
POSTGRES_SSL_CERT_DAYS=3650

# asyncpg DSN (Python services)
DATABASE_URL=postgresql://wac_user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/whatsappcollector?sslmode=require

# REQUIRED default for this stack. Supported: rabbitmq | redis
BROKER_TYPE=rabbitmq

RABBITMQ_URL=amqp://guest:CHANGE_ME_RABBITMQ_PASSWORD@rabbitmq:5672/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
RABBITMQ_ERLANG_COOKIE=CHANGE_ME_RABBITMQ_ERLANG_COOKIE
RABBITMQ_VHOST=/

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ------------------------------------------
# Storage Paths
# ------------------------------------------
# To use an external HDD, set EXTERNAL_STORAGE_ROOT to your drive path (e.g., D:\whatsapp_data)
# If left empty, the system uses internal Docker volumes.
EXTERNAL_STORAGE_ROOT=
MEDIA_STORAGE_PATH=/data/media
AUTH_STORAGE_PATH=/data/auth
FACE_MODELS_PATH=/data/models

# ------------------------------------------
# wa-client-ts (TypeScript Ingestion Client)
# ------------------------------------------
SESSION_NAME=session_1
SESSION_NAMES=session_1,session_2
SYNC_FULL_HISTORY=false
PAIRING_CODE_PHONE=
LOG_LEVEL=info

MEDIA_BRIDGE_SECRET=CHANGE_ME_MEDIA_BRIDGE_SECRET_MIN_32_CHARS
MEDIA_BRIDGE_PORT=3001
MEDIA_BRIDGE_URL=http://wa-client-ts-1:3001
# JSON map for multi-session bridge routing:
# {"session_1":"http://wa-client-ts-1:3001","session_2":"http://wa-client-ts-2:3001"}
SESSION_BRIDGES_JSON=

FINDINGS_HUB_ENABLED=true
FINDINGS_HUB_GROUP_JID=
FINDINGS_HUB_GROUP_NAME=Findings Hub
FINDINGS_SEND_DELAY=3

# ------------------------------------------
# collector (Python)
# ------------------------------------------
PYTHON_LOG_LEVEL=INFO
COLLECTOR_DEDUP_TTL_SECONDS=86400
COLLECTOR_BACKFILL_REQ_PER_MIN=5
COLLECTOR_BACKFILL_BATCH_SIZE=50
SESSION_RISK_THRESHOLD=0.8
SESSION_COOLDOWN_SECONDS=300
COLLECTOR_QR_POLL_INTERVAL_SEC=5
COLLECTOR_PROMETHEUS_PORT=9090
DASHBOARD_AUTH_REQUIRED=false
DASHBOARD_VIEWER_USERNAME=viewer
DASHBOARD_VIEWER_PASSWORD=CHANGE_ME_DASHBOARD_VIEWER_PASSWORD
DASHBOARD_OPERATOR_USERNAME=operator
DASHBOARD_OPERATOR_PASSWORD=CHANGE_ME_DASHBOARD_OPERATOR_PASSWORD
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=CHANGE_ME_DASHBOARD_ADMIN_PASSWORD
CONTROL_PLANE_SECRET_KEY=CHANGE_ME_CONTROL_PLANE_SECRET_KEY_32_BYTES
CONTROL_PLANE_SECRET_KEY_ID=local-kek-v1

# ------------------------------------------
# media_archival (Python)
# ------------------------------------------
MEDIA_ARCHIVAL_BATCH_SIZE=50
MEDIA_ARCHIVAL_POLL_SECONDS=5
MEDIA_ARCHIVAL_MAX_DOWNLOAD_RETRIES=3
MEDIA_RETENTION_DAYS=90
MEDIA_CLEANUP_INTERVAL_HOURS=24
MEDIA_REDOWNLOAD_ENABLED=false
MEDIA_REDOWNLOAD_LOOKAHEAD_HOURS=2
MEDIA_REDOWNLOAD_INTERVAL_SECONDS=1800
MAX_IMAGE_DIMENSION=4096
MEDIA_ARCHIVAL_PROMETHEUS_PORT=9091

# ------------------------------------------
# face_recognition (Python)
# ------------------------------------------
FACE_DETECTION_MODEL=hog
FACE_UPSAMPLE_TIMES=1
FACE_MATCH_THRESHOLD=0.6
FACE_PROCESSING_BATCH_SIZE=8
FACE_POLL_SECONDS=15
VIDEO_FRAME_RATE=1
VIDEO_NOTE_FRAME_RATE=2
PHASH_DEDUP_THRESHOLD=10
FACE_BIOMETRIC_SEMAPHORE=1
FINDINGS_MIN_CONFIDENCE=0.5
FINDINGS_MAX_PER_HOUR=30
FACE_RECOGNITION_PROMETHEUS_PORT=9092

# ------------------------------------------
# user_intelligence (Python)
# ------------------------------------------
USER_INTEL_BATCH_SIZE=500
USER_INTEL_POLL_INTERVAL_SEC=10
USER_INTEL_PROMETHEUS_PORT=9093

# ------------------------------------------
# link_discovery (Python)
# ------------------------------------------
LINK_DISCOVERY_BATCH_SIZE=200
LINK_DISCOVERY_POLL_INTERVAL_SEC=10
LINK_DISCOVERY_MAX_JOINS_PER_HOUR=3
LINK_DISCOVERY_JOIN_DELAY_SECONDS=120
LINK_DISCOVERY_PROMETHEUS_PORT=9094

# ------------------------------------------
# bulk_sender (Python)
# ------------------------------------------
BULK_SENDER_INTERNAL_TARGET_JID=
BULK_SENDER_INTERNAL_MIN_DELAY=2.0
BULK_SENDER_EXTERNAL_MIN_DELAY=8.0
BULK_SENDER_EXTERNAL_MAX_PER_HOUR=30
BULK_SENDER_MAX_EXTERNAL_TARGETS=20
BULK_SENDER_MEMBERSHIP_MIN_AGE_HOURS=48
BULK_SENDER_PROMETHEUS_PORT=9095

# ------------------------------------------
# dashboard (React + FastAPI)
# ------------------------------------------
DASHBOARD_PORT=8700

# ------------------------------------------
# Observability / Resilience (all Python)
# ------------------------------------------
LOG_FORMAT=json
ENABLE_PROMETHEUS=true
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=1.0
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# ------------------------------------------
# Test / CI
# ------------------------------------------
RUN_INTEGRATION_TESTS=
COMPOSE_PROJECT_NAME=whatsappcollector
BIOMETRIC_MIN_DETECTION_RATE=0.99
BIOMETRIC_MAX_FALSE_POSITIVE_RATE=0.01

# ------------------------------------------
# Legacy / compatibility variables
# ------------------------------------------
# DEPRECATED: prefer FINDINGS_MIN_CONFIDENCE for Python services.
FINDINGS_HUB_MIN_CONFIDENCE=0.1
# DEPRECATED: superseded by findings publish pipeline.
FINDINGS_HUB_BATCH_INTERVAL=30
