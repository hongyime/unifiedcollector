# =============================================================================
# WhatsApp Collector — Annotated Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# Parameters marked [TUNABLE] can be changed at runtime via the Live Config
# system (config_cli.py or the Streamlit dashboard) without a container restart.
# Parameters marked [RESTART REQUIRED] take effect only after container restart.
# Parameters marked [REQUIRED] have no safe default and MUST be set.
# =============================================================================


# =============================================================================
# SHARED INFRASTRUCTURE
# =============================================================================

# PostgreSQL connection
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=whatsappcollector
POSTGRES_USER=wac_user
POSTGRES_PASSWORD=                          # [REQUIRED] Set a strong password

# PostgreSQL TLS mode: disable | require | verify-ca | verify-full
POSTGRES_SSL_MODE=require
POSTGRES_SSL_ROOT_CERT=                     # Path to CA cert (required for verify-ca / verify-full)
POSTGRES_SSL_CLIENT_CERT=                   # Path to client cert (optional, pair with CLIENT_KEY)
POSTGRES_SSL_CLIENT_KEY=                    # Path to client key  (optional, pair with CLIENT_CERT)

# Message broker: redis | rabbitmq
BROKER_TYPE=rabbitmq
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0

# Media bridge (wa-client-ts)
MEDIA_BRIDGE_URL=http://wa-client-ts:3001
MEDIA_BRIDGE_SECRET=                        # [REQUIRED] Min 32 chars, used for HMAC auth

# Multi-session bridge mapping (JSON). Overrides MEDIA_BRIDGE_URL when set.
# Example: {"session_1":"http://wa-client-ts-1:3001","session_2":"http://wa-client-ts-2:3001"}
SESSION_BRIDGES_JSON=
SESSION_NAMES=session_1

# Media storage root (shared volume)
MEDIA_STORAGE_PATH=/data/media

# Maximum allowed message payload size in bytes (default: 10 MB)
MAX_PAYLOAD_BYTES=10485760


# =============================================================================
# PROCESSOR-PY  (services/processor-py)
# =============================================================================

# --- Logging ---
# [TUNABLE] Log verbosity for the processor service.
# Type: str | Options: DEBUG, INFO, WARNING, ERROR | Default: INFO
PYTHON_LOG_LEVEL=INFO

# --- Media Processing ---
# [TUNABLE] Maximum pixel dimension (width or height) for image resizing before
# face detection. Larger values improve accuracy but increase CPU/memory usage.
# Type: int | Min: 256 | Default: 4096
MAX_IMAGE_DIMENSION=4096

# [TUNABLE] Number of frames extracted per second from video files for processing.
# Higher values increase coverage but slow down the pipeline significantly.
# Type: int | Min: 1 | Default: 1
VIDEO_FRAME_RATE=1

# [TUNABLE] Perceptual hash similarity threshold for near-duplicate image detection.
# Lower = stricter deduplication (fewer duplicates pass through).
# Type: int | Range: 0–64 | Default: 10
PHASH_DEDUP_THRESHOLD=10

# --- Biometric Pipeline ---
# [RESTART REQUIRED] Face detection model. 'hog' is fast (CPU); 'cnn' is accurate (GPU).
# Changing this mid-run would leave in-flight frames using the old model.
# Type: str | Options: hog, cnn | Default: hog
FACE_DETECTION_MODEL=hog

# [TUNABLE] Face embedding similarity threshold for identity matching.
# Lower = stricter matching (fewer false positives, more new identities created).
# Type: float | Range: 0.0–1.0 | Default: 0.6
FACE_MATCH_THRESHOLD=0.6

# [TUNABLE] Number of times to upsample the image before face detection.
# Higher values find smaller faces but are slower.
# Type: int | Min: 0 | Default: 1
FACE_UPSAMPLE_TIMES=1

# --- Findings Hub ---
# [TUNABLE] How often (seconds) the findings publisher flushes its batch to the hub group.
# Type: int | Min: 10 | Default: 60
FINDINGS_HUB_BATCH_INTERVAL=60

# [TUNABLE] Minimum face match confidence required before publishing a sighting.
# Type: float | Range: 0.0–1.0 | Default: 0.5
FINDINGS_HUB_MIN_CONFIDENCE=0.5

# --- Media Redownload ---
# [TUNABLE] Enable background re-download of media that is about to expire.
# Type: bool | Default: false
MEDIA_REDOWNLOAD_ENABLED=false

# [TUNABLE] How many hours ahead to look for expiring media to re-download.
# Type: int | Min: 1 | Default: 2
MEDIA_REDOWNLOAD_LOOKAHEAD_HOURS=2

# --- Database Connection Pool ---
# [RESTART REQUIRED] SQLAlchemy async pool settings. Changes require restart to
# tear down and rebuild the connection pool.
# Type: int | Default: 5
DB_POOL_SIZE=5
# Type: int | Default: 10
DB_MAX_OVERFLOW=10
# Type: int (seconds) | Default: 30
DB_POOL_TIMEOUT=30
# Type: int (seconds) | Default: 1800
DB_POOL_RECYCLE=1800

# Dlib models path (not tunable — must match Docker volume mount)
DLIB_MODELS_PATH=/data/models


# =============================================================================
# COLLECTOR  (services/collector)
# =============================================================================

# --- Logging ---
# [TUNABLE] Log verbosity for the collector service.
# Type: str | Options: DEBUG, INFO, WARNING, ERROR | Default: INFO
LOG_LEVEL=INFO

# --- Backfill ---
# [TUNABLE] Maximum number of backfill API requests per minute per session.
# Reduce if sessions are being rate-limited or flagged.
# Type: int | Min: 1 | Default: 5
COLLECTOR_BACKFILL_REQ_PER_MIN=5

# [TUNABLE] How often (seconds) the backfill worker polls for new jobs.
# Type: int | Min: 5 | Default: 30
COLLECTOR_BACKFILL_POLL_SECONDS=30

# [TUNABLE] Maximum age (days) of messages to include in backfill requests.
# Type: int | Min: 1 | Default: 90
COLLECTOR_MAX_BACKFILL_AGE_DAYS=90

# --- Deduplication ---
# [TUNABLE] TTL (seconds) for the Redis deduplication cache.
# Messages seen within this window are dropped as duplicates.
# Type: int | Min: 60 | Default: 86400 (24 h)
COLLECTOR_DEDUP_TTL_SECONDS=86400

# --- Session Risk / Health ---
# [TUNABLE] Risk score threshold (0.0–1.0) above which a session is put into cooldown.
# Lower = more aggressive cooldown triggering.
# Type: float | Range: 0.0–1.0 | Default: 0.8
SESSION_RISK_THRESHOLD=0.8

# [TUNABLE] Duration (seconds) a session stays in cooldown after exceeding risk threshold.
# Type: int | Min: 30 | Default: 300
SESSION_COOLDOWN_SECONDS=300

# [TUNABLE] Rolling window (seconds) over which session risk events are counted.
# Type: int | Min: 60 | Default: 3600
SESSION_RISK_WINDOW_SECONDS=3600

# --- Dashboard Authentication / Authorization ---
# [RESTART REQUIRED] Require sign-in for mutation authorization checks.
DASHBOARD_AUTH_REQUIRED=true

# [RESTART REQUIRED] Viewer role (read-only)
DASHBOARD_VIEWER_USERNAME=viewer
DASHBOARD_VIEWER_PASSWORD=

# [RESTART REQUIRED] Operator role (standard mutations)
DASHBOARD_OPERATOR_USERNAME=operator
DASHBOARD_OPERATOR_PASSWORD=

# [RESTART REQUIRED] Admin role (high-impact actions: wipe, secret reveal)
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=

# --- Control-plane Secret Storage ---
# [RESTART REQUIRED] AES key material for encrypting secrets persisted in
# collector.control_secret_values. Accepts raw 16/24/32-byte value or
# base64/urlsafe-base64 encoded key material.
CONTROL_PLANE_SECRET_KEY=

# [RESTART REQUIRED] Key identifier stored with encrypted rows for future key rotation.
CONTROL_PLANE_SECRET_KEY_ID=local-kek-v1


# =============================================================================
# MEDIA ARCHIVAL  (services/media_archival)
# =============================================================================

# --- Cleanup ---
# [TUNABLE] How often (hours) the cleanup cron runs to remove expired media files.
# Type: int | Min: 1 | Default: 24
MEDIA_CLEANUP_INTERVAL_HOURS=24

# [TUNABLE] Number of days to retain downloaded media before deletion.
# Type: int | Min: 1 | Default: 90
MEDIA_RETENTION_DAYS=90

# --- Redownload ---
# [TUNABLE] Enable proactive re-download of media approaching expiry.
# Type: bool | Default: false
# Note: Also set in processor-py; both must be enabled for full coverage.
MEDIA_REDOWNLOAD_ENABLED=false

# [TUNABLE] Hours ahead to look for expiring media.
# Type: int | Min: 1 | Default: 2
MEDIA_REDOWNLOAD_LOOKAHEAD_HOURS=2

# [TUNABLE] How often (seconds) the redownload background task runs.
# Type: int | Min: 60 | Default: 1800
MEDIA_REDOWNLOAD_INTERVAL_SECONDS=1800

# --- Worker Loop ---
# [TUNABLE] How often (seconds) the archival worker polls for new download jobs.
# Type: int | Min: 1 | Default: 5
MEDIA_ARCHIVAL_POLL_SECONDS=5

# [TUNABLE] Number of media items processed per worker loop iteration.
# Type: int | Min: 1 | Default: 50
MEDIA_ARCHIVAL_BATCH_SIZE=50

# [TUNABLE] Maximum number of download retry attempts before marking a media item as failed.
# Type: int | Min: 1 | Default: 3
MEDIA_ARCHIVAL_MAX_DOWNLOAD_RETRIES=3


# =============================================================================
# FACE RECOGNITION  (services/face_recognition)
# =============================================================================

# --- Detection / Matching ---
# [TUNABLE] Face similarity threshold for identity clustering.
# Type: float | Range: 0.0–1.0 | Default: 0.6
FACE_MATCH_THRESHOLD=0.6

# [TUNABLE] Upsample count before face detection (finds smaller faces, slower).
# Type: int | Min: 0 | Default: 1
FACE_UPSAMPLE_TIMES=1

# [RESTART REQUIRED] Detection model: hog (fast/CPU) or cnn (accurate/GPU).
# Type: str | Options: hog, cnn | Default: hog
FACE_DETECTION_MODEL=hog

# [TUNABLE] Number of images processed per batch in the face recognition pipeline.
# Type: int | Min: 1 | Default: 8
FACE_PROCESSING_BATCH_SIZE=8

# [TUNABLE] How often (seconds) the face recognition worker polls for new media.
# Type: int | Min: 1 | Default: 15
FACE_POLL_SECONDS=15

# [TUNABLE] Maximum image dimension before resizing (face_recognition service copy).
# Type: int | Min: 256 | Default: 1600
MAX_IMAGE_DIMENSION=1600

# [TUNABLE] Frames per second extracted from regular video files.
# Type: int | Min: 1 | Default: 1
VIDEO_FRAME_RATE=1

# [TUNABLE] Frames per second extracted from video note (voice note video) files.
# Type: int | Min: 1 | Default: 2
VIDEO_NOTE_FRAME_RATE=2

# [TUNABLE] Perceptual hash dedup threshold (face_recognition service copy).
# Type: int | Range: 0–64 | Default: 10
PHASH_DEDUP_THRESHOLD=10

# --- Findings Publication ---
# [TUNABLE] Maximum number of findings published per hour to avoid flooding the hub.
# Type: int | Min: 1 | Default: 30
FINDINGS_MAX_PER_HOUR=30

# [TUNABLE] Delay (seconds) between consecutive findings publications.
# Type: float | Min: 0.5 | Default: 3.0
FINDINGS_SEND_DELAY=3.0

# [TUNABLE] Minimum confidence score required to publish a face sighting.
# Type: float | Range: 0.0–1.0 | Default: 0.5
FINDINGS_MIN_CONFIDENCE=0.5

# [RESTART REQUIRED] Max concurrent biometric encoding tasks (semaphore limit).
# Increase only if running on multi-core hardware with sufficient memory.
# Type: int | Min: 1 | Default: 1
FACE_BIOMETRIC_SEMAPHORE=1


# =============================================================================
# USER INTELLIGENCE  (services/user_intelligence)
# =============================================================================

# [TUNABLE] Number of user records processed per batch in the change-tracking loop.
# Type: int | Min: 1 | Default: 500
USER_INTEL_BATCH_SIZE=500

# [TUNABLE] How often (seconds) the user intelligence worker polls for profile changes.
# Type: int | Min: 1 | Default: 10
USER_INTEL_POLL_INTERVAL_SEC=10

# [TUNABLE] Comma-separated list of user profile fields to track for changes.
# Removing a field stops change detection for it; adding a field starts tracking it.
# Type: str (CSV) | Default: display_name,push_name,business_name,phone_number,is_business,is_verified,profile_photo
TRACKED_FIELDS=display_name,push_name,business_name,phone_number,is_business,is_verified,profile_photo


# =============================================================================
# LINK DISCOVERY  (services/link_discovery)
# =============================================================================

# [TUNABLE] Number of group links processed per batch.
# Type: int | Min: 1 | Default: 200
LINK_DISCOVERY_BATCH_SIZE=200

# [TUNABLE] How often (seconds) the link discovery worker polls for new links.
# Type: int | Min: 1 | Default: 10
LINK_DISCOVERY_POLL_INTERVAL_SEC=10

# [TUNABLE] Maximum number of group join attempts per hour.
# Keep low to avoid triggering WhatsApp rate limits.
# Type: int | Min: 1 | Default: 3
LINK_DISCOVERY_MAX_JOINS_PER_HOUR=3

# [TUNABLE] Minimum delay (seconds) between consecutive group join attempts.
# Type: int | Min: 30 | Default: 120
LINK_DISCOVERY_JOIN_DELAY_SECONDS=120


# =============================================================================
# BULK SENDER  (services/bulk_sender)
# =============================================================================

# [TUNABLE] Minimum delay (seconds) between messages sent to internal targets.
# Type: float | Min: 0.5 | Default: 2.0
BULK_SENDER_INTERNAL_MIN_DELAY=2.0

# [TUNABLE] Minimum delay (seconds) between messages sent to external targets.
# Keep high to avoid rate-limiting. Recommended: ≥ 5.0
# Type: float | Min: 1.0 | Default: 8.0
BULK_SENDER_EXTERNAL_MIN_DELAY=8.0

# [TUNABLE] Maximum number of external messages sent per hour across all sessions.
# Type: int | Min: 1 | Default: 30
BULK_SENDER_EXTERNAL_MAX_PER_HOUR=30

# [TUNABLE] Maximum number of distinct external targets per bulk send job.
# Type: int | Min: 1 | Default: 20
BULK_SENDER_MAX_EXTERNAL_TARGETS=20

# [TUNABLE] Minimum group membership age (hours) before a session may send to that group.
# Prevents sending from freshly-joined sessions.
# Type: int | Min: 1 | Default: 48
BULK_SENDER_MEMBERSHIP_MIN_AGE_HOURS=48

# [TUNABLE] How often (seconds) the bulk sender worker polls for new send jobs.
# Type: int | Min: 1 | Default: 5
BULK_SENDER_POLL_INTERVAL_SEC=5
