# .env.example — Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ---- Database Configuration ----
# Controls which database backend is used.
# Leave blank (or omit) to use the default SQLite database at data/instagram_toolkit.db

# SQLite example (default — no extra dependencies required):
DATABASE_URL=sqlite:///data/instagram_toolkit.db

# PostgreSQL example (requires: pip install psycopg2-binary):
# DATABASE_URL=postgresql://username:password@localhost:5432/instagram_toolkit

# DATABASE_URL=

# ---- Profile Photo Blob Storage ----
# Maximum database size for storing profile photo blobs (in MB)
# When DB exceeds this size, profile photos are tracked but not stored as blobs
PROFILE_PHOTO_BLOB_MAX_SIZE_MB=5000

# ---- Download Filters ----
# Set to 0 to disable a filter (matches everyone)
FILTER_MAX_FOLLOWERS=0
FILTER_MIN_FOLLOWERS=0
FILTER_MAX_FOLLOWING=0
FILTER_MIN_FOLLOWING=0
FILTER_PUBLIC_ONLY=false

# ---- Sliding Window Rate Limiting ----
# Enable/disable sliding window rate limiting to prevent account bans
# Default: false (use with caution, test first)
SLIDING_WINDOW_ENABLED=false

# Sliding window limits (requests per time window)
# These are SAFETY LIMITS to prevent account bans
# Adjust based on your risk tolerance and account age/quality
WINDOW_1H_LIMIT=180      # Max requests per hour (Instagram ~200/hr limit)
WINDOW_3H_LIMIT=400      # Max requests per 3 hours
WINDOW_5H_LIMIT=600      # Max requests per 5 hours
WINDOW_1D_LIMIT=2000     # Max requests per day (Instagram ~7500/day limit)

# How long to keep request logs in database (prevents DB bloat)
# Default: 24 hours (adjust based on your needs)
REQUEST_LOG_RETENTION_HOURS=24

# Optional: Machine ID for debugging/monitoring (auto-detected if not set)
# Useful when running from multiple machines
# MACHINE_ID=workstation1

# ---- Instagram Toolkit Credentials ----
# Add as many accounts as you need by incrementing the number.
# Format: INSTA_ACCOUNT_N_NAME, INSTA_ACCOUNT_N_USER, INSTA_ACCOUNT_N_PASS

INSTA_ACCOUNT_1_NAME=account_name_1
INSTA_ACCOUNT_1_USER=instagram_username_1
INSTA_ACCOUNT_1_PASS=instagram_password_1

INSTA_ACCOUNT_2_NAME=account_name_2
INSTA_ACCOUNT_2_USER=instagram_username_2
INSTA_ACCOUNT_2_PASS=instagram_password_2

# Add more accounts below (just increment the number):
# INSTA_ACCOUNT_3_NAME=account_name_3
# INSTA_ACCOUNT_3_USER=instagram_username_3
# INSTA_ACCOUNT_3_PASS=instagram_password_3

# ---- Optional: Per-account proxy ----
# INSTA_ACCOUNT_1_PROXY=socks5://user:pass@host:port

# ---- Optional: Global proxy ----
# PROXY_URL=socks5://user:pass@host:port
