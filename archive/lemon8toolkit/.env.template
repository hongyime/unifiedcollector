# Lemon8 Toolkit Configuration Template
# Copy this file to .env and customize the values

# ============================================================================
# Directory Configuration
# ============================================================================
DATA_DIR=data
DOWNLOADS_DIR=downloads

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Minimum delay between requests (seconds)
MIN_DELAY=1

# Maximum delay between requests (seconds)
MAX_DELAY=3

# Maximum requests per minute
REQUESTS_PER_MINUTE=30

# ============================================================================
# Media Configuration
# ============================================================================
# Maximum file size to download (MB)
MAX_MEDIA_SIZE_MB=100

# Download chunk size (bytes)
CHUNK_SIZE=8192

# ============================================================================
# Image Quality Configuration
# ============================================================================
# Enable image enhancement
IMAGE_ENHANCEMENT_ENABLED=true

# Enable high quality fallback
ENABLE_HIGH_QUALITY_FALLBACK=true

# Target image dimensions
HIGH_QUALITY_IMAGE_WIDTH=2160
HIGH_QUALITY_IMAGE_HEIGHT=2160
HIGH_QUALITY_IMAGE_QUALITY=100

# Minimum image dimensions
MIN_IMAGE_WIDTH=320
MIN_IMAGE_HEIGHT=320
MIN_IMAGE_FILE_SIZE_BYTES=8192

# ============================================================================
# Profile Photo Configuration
# ============================================================================
# Enable profile photo downloads
PROFILE_PHOTO_DOWNLOAD_ENABLED=true

# Include profile photos in user scrapes
INCLUDE_PROFILE_IMAGES_IN_USER_SCRAPES=true

# Include profile photos in feed scrapes
INCLUDE_PROFILE_IMAGES_IN_FEED=false

# Minimum profile image dimensions
MIN_PROFILE_IMAGE_WIDTH=100
MIN_PROFILE_IMAGE_HEIGHT=100
MIN_PROFILE_IMAGE_FILE_SIZE_BYTES=2048

# ============================================================================
# Profile Photo Blob Storage
# ============================================================================
# Maximum blob storage size (bytes) - 5GB default
PROFILE_PHOTO_BLOB_THRESHOLD=5368709120

# ============================================================================
# Username Configuration
# ============================================================================
# Enable username prefix in filenames
USERNAME_PREFIX_ENABLED=true

# Strict username validation
STRICT_USERNAME_VALIDATION=false

# Maximum username length
USERNAME_MAX_LENGTH=64

# ============================================================================
# Multi-Account Configuration
# ============================================================================
# Primary account cookies file
LEMON8_COOKIES_FILE=cookies.txt

# Additional account cookies (optional)
# LEMON8_ACCOUNT_1_COOKIES=sessions/account1_cookies.txt
# LEMON8_ACCOUNT_2_COOKIES=sessions/account2_cookies.txt
# LEMON8_ACCOUNT_3_COOKIES=sessions/account3_cookies.txt

# ============================================================================
# Spidering Configuration
# ============================================================================
# Enable automatic spidering
SPIDERING_ENABLED=true

# Maximum users to spider per batch
SPIDER_BATCH_SIZE=100

# ============================================================================
# User Agent
# ============================================================================
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
