# Old toolkit folders (legacy V1, no longer used)
instagramtoolkit/
githubtoolkit/
youtubetoolkit/
tiktoktoolkit/
whatsappcollector/
telegramtoolkit/
stravatoolkit/
lemon8toolkit/

# Per-platform venvs and caches
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Storage / data (mounted from Z:, never in image)
data/
backups/
sessions/
whatsapp_session/
*.session
*.session-journal
*.db
*.sqlite
*.sqlite-*

# Logs and temp
logs/
*.log
tmp/
.tmp/

# Git / IDE
.git/
.gitignore
.idea/
.vscode/
.claude/

# Docs
*.md
!README.md
docs/

# OS / editor noise
Thumbs.db
.DS_Store
desktop.ini

# Bloat that was inflating the build context (slow builds + disk churn)
archive/
**/node_modules/
extension/
research/

# Build context privacy and development caches.
**/.git
**/.agents
**/.env*
**/node_modules
**/.venv
**/__pycache__
**/tests
**/test_*.py
**/logs
**/backups
**/sessions
**/auth_info*
**/credentials.json
**/cookies*.txt
**/*.pem
**/*.key

# Exclude private files regardless of capitalization.
**/.[eE][nN][vV]*
**/*[sS][eE][cC][rR][eE][tT]*
**/*[cC][rR][eE][dD][eE][nN][tT][iI][aA][lL]*
**/*.[pP][eE][mM]
**/*.[kK][eE][yY]
**/*.[pP]12
**/*.[pP][fF][xX]

# Functional tracked source; private credential data remains excluded.
!src/collectors/instagram_dm/credentials.py
