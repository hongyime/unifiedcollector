# .env.example — canonical environment template (P1-4, regenerated 2026-05-30)
# Generated from the live .env with ALL values stripped. Copy to .env and fill in.
# Keys are the complete current set the collector/dashboard/bots read.

# UnifiedCollector — Unified Environment Configuration
# Auto-generated by scripts/migrate_env.py from legacy toolkit .env files.
# Review and adjust values before use.

# -- Database -----------------------------------------------
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=  # REQUIRED — set your own secret

# -- Storage ------------------------------------------------
COLLECTOR_DRIVE_PATH=

# -- GitHub -------------------------------------------------
# Migrated from: githubtoolkit/.env → GITHUB_PAT (renamed to GITHUB_TOKEN)
# Comma-separated PATs supported (rotation across multiple tokens)
GITHUB_TOKEN=  # REQUIRED — set your own secret
GITHUB_AVATAR_SIZE=
GITHUB_API_DELAY=  # REQUIRED — set your own secret
GITHUB_MAX_CONCURRENT=
GITHUB_TARGET_CONCURRENCY=
GITHUB_SPIDER_CONCURRENCY=
GITHUB_SPIDER_BATCH_SIZE=
GITHUB_MAX_COMMITS_PER_REPO=
GITHUB_MAX_ISSUES_PER_REPO=
GITHUB_MAX_CONTRIBUTORS_PER_REPO=
GITHUB_SPIDER_DEPTH=
GITHUB_DOWNLOAD_DELAY=
GITHUB_PROFILE_PHOTO_BLOB_MAX_SIZE_MB=

# -- Instagram ----------------------------------------------
# Migrated from: instagramtoolkit/.env (username/password auth via Instaloader)
INSTA_ACCOUNT_1_NAME=
INSTA_ACCOUNT_1_USER=
INSTA_ACCOUNT_1_PASS=
INSTA_ACCOUNT_1_BROWSER=

INSTA_ACCOUNT_2_NAME=
INSTA_ACCOUNT_2_USER=
INSTA_ACCOUNT_2_BROWSER=
