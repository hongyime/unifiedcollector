# --- Media reconciler (src/core/reconciler.py) ---
# Re-download media_items whose backing file is missing. Bounded, drive-gated,
# tombstoning. Safe to leave on permanently — sources self-complete and drop to
# fast mode (recover_state), and dead assets get tombstoned (media_recover_state).
COLLECTOR_RECOVER_MISSING=        # 1/true to enable the reconciler
COLLECTOR_RECOVER_PER_CYCLE=200   # max re-downloads released per collect cycle (0=unlimited)

# --- Global media-I/O pacer (src/core/io_pacer.py) ---
# ONE shared Redis token bucket capping aggregate bytes/sec written to Z across ALL
# collectors — replaces the ~8 hand-tuned per-source rate knobs that individually
# saturated the Z drive with no coordination. Ships DORMANT; enable deliberately
# after watching baseline Z load, then set the ceiling. Fail-open (Redis down =
# no pacing, never blocks collection).
MEDIA_IO_PACER_ENABLED=0          # 1/true to enable global Z write pacing
MEDIA_IO_BYTES_PER_SEC=8000000    # aggregate ceiling (8 MB/s default) — TUNE to Z
MEDIA_IO_BURST_BYTES=             # burst allowance (default = 4× rate)
MEDIA_IO_MAX_SLEEP=30             # max single-acquire wait (misconfig guard)
COLLECTOR_RECOVER_DONE_CYCLES=3   # consecutive clean cycles before a source is marked done (0=never)
RECONCILE_TOMBSTONE_ATTEMPTS=5    # failed re-downloads before an item is permanently skipped (0=never)
RECONCILE_SHARDS=1                # check 1/N of the corpus per cycle, rotating (1=all every cycle)
RECONCILE_ALERT_MISSING_PCT=0.5   # alert if >this fraction of known files missing in a cycle (drive-failure signal)
RECONCILE_SHA256_SAMPLE_RATE=0    # opt-in tier-2: fraction of files to sha256-verify for corruption (0=off)
