# -- Telegram notification bot (send-only) ------------------
# The status/alert bot is DISTINCT from the collector bots above. It uses a
# dedicated token so a compromised alert channel can't affect collection.
# See src/notifications/telegram.py + src/notifications/alerts.py.
NOTIFY_TELEGRAM_BOT_TOKEN=  # REQUIRED — set your own secret
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_TELEGRAM_THREAD_ID=
TELEGRAM_CHAT_ID=          # fallback if NOTIFY_TELEGRAM_CHAT_ID is unset
TELEGRAM_THREAD_ID=
# Hourly categorised digest cadence (0 disables).
STATUS_HEARTBEAT_INTERVAL_HOURS=1
# 15-min delta status update on top of the hourly digest (0 disables).
STATUS_DELTA_INTERVAL_MINUTES=15

# -- Self-bot circular-loop safety --------------------------
# The realtime-feed bot posts every newly-scraped media item to a Telegram log
# group. If the telegram collector ALSO monitors that group (via Telethon), the
# bot's own message gets re-ingested as a new media_items row, which the feed
# then re-sends, ad infinitum. Two independent filter layers guard against this:
#
#   Layer 1: skip by sender bot user_id. Set UC_NOTIFY_BOT_USER_ID to the
#            numeric user_id of the bot behind NOTIFY_TELEGRAM_BOT_TOKEN. If
#            unset, the collector resolves it once at startup via
#              curl https://api.telegram.org/bot<NOTIFY_TELEGRAM_BOT_TOKEN>/getMe
#            and caches in memory.
#   Layer 2: fallback by chat_id. TELEGRAM_LOGS_CHAT_ID names the log chat
#            itself. If the bot user_id is known, human/manual posts in that
#            chat are still ingested and only the bot's own messages are
#            skipped. If the bot user_id is unavailable, the collector skips
#            the whole logs chat to avoid a loop. Defaults to TELEGRAM_CHAT_ID
#            (falling back to NOTIFY_TELEGRAM_CHAT_ID).
#
# The realtime feed (src/notifications/realtime_feed.py) also drops telegram
# payloads from the logs chat as defence-in-depth, using the same sender-aware
# rule when UC_NOTIFY_BOT_USER_ID is available.
UC_NOTIFY_BOT_USER_ID=
TELEGRAM_LOGS_CHAT_ID=

# -- Real-time post feed ------------------------------------
# Each newly-inserted media_items row is enqueued to Redis and drained by the
# realtime_feed service which posts a per-post Telegram message. Rate-limited;
# see src/notifications/realtime_feed.py.
REALTIME_POST_FEED_ENABLED=1
REALTIME_POST_FEED_MAX_PER_MINUTE=6
REALTIME_POST_FEED_DEDUPE_TTL_DAYS=7
REALTIME_POST_FEED_INCLUDE_PROFILES=0
REALTIME_POST_FEED_BURST_SUMMARY=1
REALTIME_POST_FEED_BURST_SUMMARY_SECONDS=900

# -- Browser cookie vault -----------------------------------
# Snapshots host Chrome social cookies every 5 min via CDP; auto-restores them
# on container start when AUTORESTORE=1 so a Chrome profile wipe never strands
# a collector. See src/tools/browser_cookie_vault.py.
BROWSER_COOKIE_VAULT_AUTORESTORE=1
BROWSER_COOKIE_VAULT_INTERVAL_SECONDS=300
BROWSER_COOKIE_VAULT_KEEP_SNAPSHOTS=10
BROWSER_COOKIE_VAULT_HEALTH_PORT=8790
CHROME_CDP_URL=http://host.docker.internal:9222


