INSTA_ACCOUNT_5_PASS=

INSTA_ACCOUNT_6_NAME=
INSTA_ACCOUNT_6_USER=
INSTA_ACCOUNT_6_BROWSER=
INSTA_ACCOUNT_6_PASS=
FILTER_MAX_FOLLOWERS=
# Rate limiting (set false for faster testing)
SLIDING_WINDOW_ENABLED=
INSTA_WINDOW_1H=
INSTA_WINDOW_3H=
INSTA_WINDOW_5H=
INSTA_WINDOW_1D=
# Content-aware delays (adjusts timing per content type)
CONTENT_AWARE_ENABLED=
# Daily quota budget per account (0 = unlimited)
INSTA_DAILY_QUOTA_PROFILE_VIEWS=
INSTA_DAILY_QUOTA_ACTIONS=
# Warmup (3x 30-60s pauses before collection)
INSTA_WARMUP_ENABLED=

# Disable Tor proxy for Instagram (getting 429 via Tor)
INSTA_PROXY_DISABLED=

