# ---- Database ----
DATABASE_URL=postgres://collector:collector@localhost:5432/unifiedcollector
POSTGRES_USER=collector
POSTGRES_PASSWORD=collector
# PostgreSQL SSL (optional, empty = no SSL)
POSTGRES_SSL_MODE=
POSTGRES_SSL_CERT=

# ---- Storage ----
COLLECTOR_DRIVE_PATH=Z:/media

# ---- GitHub ----
# Comma-separated PATs for rotation (was GITHUB_PAT in githubtoolkit)
GITHUB_TOKEN=
GITHUB_AVATAR_SIZE=460
GITHUB_API_DELAY=0.1
GITHUB_DOWNLOAD_DELAY=0.5
GITHUB_MAX_CONCURRENT=5
GITHUB_SPIDER_DEPTH=4
GITHUB_PROFILE_PHOTO_BLOB_MAX_SIZE_MB=5000

# ---- Instagram ----
# Multi-account login via Instaloader (reuse from instagramtoolkit)
INSTA_ACCOUNT_1_NAME=
INSTA_ACCOUNT_1_USER=
INSTA_ACCOUNT_1_PASS=
# INSTA_ACCOUNT_2_NAME= ... up to N accounts
# Per-account proxy (optional): INSTA_ACCOUNT_1_PROXY=socks5://user:pass@host:port
# Global proxy (optional, used if no per-account proxy set)
# PROXY_URL=socks5://user:pass@host:port
# Browser cookie import (Netscape format, tried before password login)
# INSTA_ACCOUNT_1_BROWSER=credentials/instagram/cookies/account_1_cookies.txt
# Fallback single-session mode
INSTAGRAM_SESSION_ID=
INSTAGRAM_CSRF_TOKEN=
INSTAGRAM_COLLECT_STORIES=true
INSTAGRAM_COLLECT_HIGHLIGHTS=true
INSTAGRAM_COLLECT_FOLLOWERS=false
FILTER_MAX_FOLLOWERS=960
# Sliding window rate limits (match instagramtoolkit defaults)
# Set SLIDING_WINDOW_ENABLED=false for testing speed (WARNING: may trigger bans)
SLIDING_WINDOW_ENABLED=true
INSTA_WINDOW_1H=180
INSTA_WINDOW_3H=400
INSTA_WINDOW_5H=600
INSTA_WINDOW_1D=2000
# Content-aware delays (adjusts timing based on content type: video=6s, reel=7s, story=2s)
CONTENT_AWARE_ENABLED=true
# Daily quota budget per account (0 = unlimited)
INSTA_DAILY_QUOTA_PROFILE_VIEWS=180
INSTA_DAILY_QUOTA_ACTIONS=6000
# Warmup toggle (default: true, 3x 30-60s pauses before collection)
INSTA_WARMUP_ENABLED=true

# ---- Telegram ----
# Reuse from telegramcollector (was TG_API_ID / TG_API_HASH)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=collector
TELEGRAM_BATCH_SIZE=100
TELEGRAM_MAX_MEDIA_SIZE_MB=50
TELEGRAM_BACKFILL_ENABLED=true
TELEGRAM_BACKFILL_MSG_PER_SEC=20.0
TELEGRAM_STORY_SCAN_ENABLED=true
TELEGRAM_STORY_SCAN_INTERVAL=300
# Multi-session rotation
TELEGRAM_ACCOUNT_1_NAME=
TELEGRAM_ACCOUNT_1_API_ID=
TELEGRAM_ACCOUNT_1_API_HASH=
TELEGRAM_ACCOUNT_1_PHONE=
TELEGRAM_ACCOUNT_1_SESSION=
# TELEGRAM_ACCOUNT_2_NAME= ... up to N accounts

# ---- YouTube ----
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_COOKIE_BROWSER=auto
YOUTUBE_MAX_VIDEO_DURATION_MINUTES=18
YOUTUBE_YTDLP_FORMAT=best
YOUTUBE_DOWNLOAD_DELAY=5.0
YOUTUBE_API_DELAY=1.0
YOUTUBE_MAX_CONCURRENT=3
YOUTUBE_DOWNLOAD_VIDEOS=true

# ---- Strava ----
# OAuth API mode
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
# Web scraping mode (reuse from stravatoolkit)
STRAVA_SESSION_COOKIE=
STRAVA_API_DELAY_MIN=5.0
STRAVA_API_DELAY_MAX=10.0
STRAVA_FEED_DELAY_MIN=5.0
STRAVA_FEED_DELAY_MAX=12.0
STRAVA_BACKFILL_STEPS=25
STRAVA_BACKFILL_PARALLELISM=3

# ---- TikTok ----
TIKTOK_SESSION_ID=
TIKTOK_COOKIES_FILE=configs/tiktok_cookies.txt
TIKTOK_MIN_SLEEP=0.5
TIKTOK_MAX_SLEEP=2.0
TIKTOK_RETRIES=2
TIKTOK_TIMEOUT_SECONDS=120
TIKTOK_BROWSER_FALLBACK_ENABLED=true
TIKTOK_YTDLP_FALLBACK_ENABLED=true
TIKTOK_USER_AGENT=

# ---- Lemon8 ----
LEMON8_COOKIES_FILE=cookies.txt
LEMON8_SESSION_ID=
LEMON8_MIN_WIDTH=320
LEMON8_MIN_HEIGHT=320
LEMON8_MIN_FILE_SIZE=8192
LEMON8_HIGH_QUALITY_WIDTH=2160

# ---- Search ----
# Supports both var names (reuse from searchtoolkit)
SEARCH_API_KEY=
SERPER_API_KEY=
SEARCH_MAX_RESULTS=50
SEARCH_MIN_DIMENSION=200
SEARCH_MIN_FILE_SIZE=10240
SEARCH_CACHE_TTL_HOURS=24

# ---- Website ----
WEBSITE_MAX_DEPTH=3
WEBSITE_MAX_PAGES=500
WEBSITE_TIMEOUT=30
WEBSITE_MAX_CONCURRENT_TASKS=5
WEBSITE_MIN_WIDTH=100
WEBSITE_MIN_HEIGHT=100
WEBSITE_MIN_FILE_SIZE=5120

# ---- WhatsApp ----
# Offline import mode
WHATSAPP_EXPORT_DIR=
# Real-time mode (reuse from whatsappcollector)
SESSION_NAMES=session_1,session_2
SESSION_BRIDGES_JSON={"session_1":"http://wa-client-ts-1:3001","session_2":"http://wa-client-ts-2:3001"}
MEDIA_BRIDGE_SECRET=
BROKER_TYPE=rabbitmq
RABBITMQ_URL=amqp://wac_user:password@rabbitmq:5672/
REDIS_URL=redis://:password@redis:6379/0
COLLECTOR_DEDUP_TTL_SECONDS=86400
COLLECTOR_BACKFILL_REQ_PER_MIN=5
COLLECTOR_BACKFILL_BATCH_SIZE=50
COLLECTOR_BACKFILL_POLL_SECONDS=30
COLLECTOR_MAX_BACKFILL_AGE_DAYS=90
MEDIA_ARCHIVAL_BATCH_SIZE=50
MEDIA_ARCHIVAL_POLL_SECONDS=5
MEDIA_ARCHIVAL_MAX_DOWNLOAD_RETRIES=3
MEDIA_RETENTION_DAYS=90
SESSION_RISK_THRESHOLD=0.8
SESSION_COOLDOWN_SECONDS=300
# Face recognition dlib models (auto-downloaded to models/dlib/ if empty)
# Run: python scripts/download_dlib_models.py
DLIB_MODELS_PATH=
