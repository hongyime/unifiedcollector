# -- WhatsApp -----------------------------------------------
# Migrated from: whatsappcollector/.env
# Real-time bridge stack: rabbitmq + redis + wa-bridge (Baileys) services in compose
# offline export reader mode (leave blank when using real-time bridges)
WHATSAPP_EXPORT_DIR=
# Real-time mode credentials (from whatsappcollector/.env)
WHATSAPP_SESSION_NAMES=
WHATSAPP_MEDIA_BRIDGE_SECRET=  # REQUIRED — set your own secret
WHATSAPP_FINDINGS_HUB_GROUP_JID=
WHATSAPP_RABBITMQ_URL=
WHATSAPP_REDIS_URL=
WHATSAPP_BROKER_TYPE=
# Maps session name -> bridge HTTP base URL for media fetches
WHATSAPP_SESSION_BRIDGES_JSON=
# RabbitMQ + Redis service credentials (consumed by both broker containers and bridges)
RABBITMQ_USER=
RABBITMQ_PASSWORD=  # REQUIRED — set your own secret
RABBITMQ_VHOST=
REDIS_PASSWORD=  # REQUIRED — set your own secret

# -- PostgreSQL SSL (optional) ------------------------------
POSTGRES_SSL_MODE=
POSTGRES_SSL_CERT=

# -- Face Recognition Models --------------------------------
DLIB_MODELS_PATH=

# -- Dashboard ----------------------------------------------
