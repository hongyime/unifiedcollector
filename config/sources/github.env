# github.env  -- per-source tunable args (Option A)
# FAMOUS-FILTER: skip repos/users at or above this star count (overrides seed).
# Bryan: we do NOT collect famous repos/accounts.
GITHUB_FAMOUS_STAR_CAP=1000
# Apply the cap to user accounts too (sum/most-starred repo) not just repos.
GITHUB_FAMOUS_FILTER_USERS=true
