# youtube.env  -- per-source tunable args (Option A)
# KEY=VALUE per line, injected at startup unless already set by container env.
# Edit + `docker restart unifiedcollector_collector` (or the youtube container) to apply.

# Per-channel yt-dlp hard timeout (seconds). Lower = fail faster on dead/slow
# channels; the collector also auto-skips channels the YouTube API confirms missing.
YOUTUBE_TIMEOUT_SECONDS=600

# Max videos to pull per channel per cycle.
YOUTUBE_MAX_VIDEOS=25
