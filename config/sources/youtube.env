# youtube.env  -- per-source tunable args (Option A)
# Per-channel yt-dlp hard timeout (seconds).
YOUTUBE_TIMEOUT_SECONDS=600
# Max videos to pull per channel per cycle.
YOUTUBE_MAX_VIDEOS=25
# FAMOUS-FILTER: skip channels at or above this subscriber count (overrides the
# 492-sub seed). Bryan: we do NOT collect famous channels, even subscribed ones.
YOUTUBE_FAMOUS_SUB_CAP=4000
