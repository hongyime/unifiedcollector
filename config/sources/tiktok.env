# tiktok.env  -- per-source tunable args (Option A)
# KEY=VALUE per line. These are injected into the environment at worker startup
# ONLY IF not already set by the container env (real compose/.env values win).
# Edit + `docker restart unifiedcollector_collector` to apply.

# Hard timeout (seconds) for each gallery-dl / yt-dlp subprocess per user.
# Bumped from 90 -> 300 so downloads of users with many videos complete cleanly
# instead of being killed mid-download. Partial downloads are ingested on timeout.
TIKTOK_TIMEOUT_SECONDS=300

# Fallback downloaders (gallery-dl is primary; these are tried in order on failure)
TIKTOK_GALLERY_DL_FALLBACK=true
TIKTOK_YTDLP_FALLBACK=true
TIKTOK_BROWSER_FALLBACK=false
