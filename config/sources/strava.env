# strava.env  -- per-source tunable args (Option A)
# KEY=VALUE per line, injected at startup unless already set by container env.

# Spider the following/followers roster and collect everyone's activities that
# have media or map/GPS data, famous or not (NO famous filter for strava).
STRAVA_FOLLOW_SPIDER=true
# Use the web/internal endpoints (feed, following roster) in addition to the API.
STRAVA_USE_WEB=true
# Only spider out from activities that carry media or map data (per Bryan).
STRAVA_REQUIRE_MEDIA_OR_MAP=true
# Spider depth: how many hops out from your roster to follow.
STRAVA_SPIDER_MAX_DEPTH=2
