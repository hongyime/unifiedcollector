# strava.env  -- per-source tunable args (Option A)
# KEY=VALUE per line, injected at startup unless already set by container env.

# Follow-roster spider: scrape the authenticated athlete's following/followers
# and enqueue every discovered athlete into strava_spider_queue, then collect
# them. Auto-seeds from MY own athlete id (no manual id list needed).
STRAVA_FOLLOW_SCRAPE_ENABLED=true
STRAVA_SPIDER_ENABLED=true

# Only ingest media from activities that carry photos OR a map/GPS polyline
# (Bryan). Activities with neither are still upserted as metadata rows but no
# media is downloaded for them.
STRAVA_REQUIRE_MEDIA_OR_MAP=true

# GPS stream + route polyline persistence.
STRAVA_GPS_ENABLED=true

# NOTE: web/cookie mode (_use_web) is enabled by the PRESENCE of a Strava
# session cookie, NOT by an env flag. The following/follower roster spider
# REQUIRES web auth. Provide it via either:
#   STRAVA_SESSION_COOKIE=<_strava4_session value>   (in the real container env)
# or a Netscape cookie jar at:
#   STRAVA_COOKIES_FILE=credentials/strava/strava_cookies.txt
# Without it, activities still collect via the API ("me" + API targets), but
# the following/follower spider logs a skip notice and does nothing.
